--- The workspace's own logs, each a Magpie log in the workspace's folder
--- (myna_data/, or MYNA_DATA): the
--- notebooks (a row per version of a cell, keyed by notebook and cell),
--- the runs (a row per run, its position its number), the schedules (a
--- row per notebook) and the settings (a row per key). The tables a
--- notebook's cells write live beside them (myna_data/orders); the
--- workspace's own names begin with an underscore. Every function here is
--- handed what it reads and answers values, so the pages and the
--- scheduler call them alike.
use frame, magpie

--- the workspace's folder: MYNA_DATA where it is set (inside this
--- checkout, so a cell's program finds the packages it imports), else
--- myna_data
fn home[]
    return env['MYNA_DATA', 'myna_data']

fn _at[name]
    return '`home[]`/`name`'

fn ready[]
    if not exists[home[]]
        made = mkdir[home[]]

--- whether the folder is a test's own: a test removes the workspace it
--- made, and must never remove the one people work in
fn scratch[]
    return home[] ne 'myna_data'

--- a number the logs hold (an id, a position, seconds) as an int held in
--- 64 bits: each lies far below 2^62, and `int` of a cell answers an int
--- that may grow, which the bounds below keep in 64
fn small[c]
    n = int[c]
    if not n.ok
        return 0
    if n lt 0 or n gt 4000000000000000000
        return 0
    return n

--- a cell the logs hold as plain text. A log's cells are parsed values:
--- one is read by a loop over its column (an index of the column, or `.ok`
--- of the cell, which reads a key named `ok`, answers a value that can
--- fail, which a frame's column does not hold)
fn text_of[c]
    s = str[c]
    if not s.ok
        return ''
    return s

--- whether a log holds nothing yet, or is not there
fn _empty[dir]
    h = magpie.head[dir]
    if not h.ok
        return true
    return h lt 0

--- the newest version of every live cell of one notebook, in cell order
fn _live[name]
    f = magpie.latest[_at['_notebooks']]
    if not f.ok
        return f
    mine = f[f.notebook eq name]
    if not mine.ok
        return mine
    alive = mine[mine.live eq true]
    if not alive.ok
        return alive
    return sort[alive, 'cell']

--- the notebooks that hold a live cell, by name
fn names[]
    v = _names[]
    if not v.ok
        return []
    return v

fn _names[]
    seen = map[]
    if _empty[_at['_notebooks']]
        return sort[keys[seen]]
    f = magpie.latest[_at['_notebooks']]
    if not f.ok
        return sort[keys[seen]]
    alive = f[f.live eq true]
    if not alive.ok
        return sort[keys[seen]]
    for n in alive.notebook
        seen = set[seen, text_of[n], true]
    return sort[keys[seen]]

--- a notebook's cells: their ids and their sources, in one order
fn ids[name]
    found = []
    if _empty[_at['_notebooks']]
        return found
    r = _live[name]
    if not r.ok
        return found
    found = for c in r.cell
        small[c]
    return found

fn sources[name]
    found = []
    if _empty[_at['_notebooks']]
        return found
    r = _live[name]
    if not r.ok
        return found
    found = for s in r.source
        text_of[s]
    return found

--- the id a new cell of the notebook takes: one past every id it ever
--- held, so a deleted cell's id is never taken again
fn next_id[name]
    top = -1
    if _empty[_at['_notebooks']]
        return 0
    f = magpie.latest[_at['_notebooks']]
    if not f.ok
        return 0
    mine = f[f.notebook eq name]
    if not mine.ok
        return 0
    for c in mine.cell
        if small[c] gt top
            top = small[c]
    return top + 1

--- a version of a cell written: its source, whether it is live, and when
fn put_cell[name, cell, source, live, at]
    return magpie.batch[_at['_notebooks'], frame.new[notebook = [name], cell = [cell], source = [source], live = [live], at = [at]], by = ['notebook', 'cell']]

--- every version of a notebook's cells, newest first
fn versions[name]
    empty = frame.new[version = [0], at = [''], cell = [0], state = [''], change = [''], source = ['']]
    none = empty[empty.cell lt 0]
    if _empty[_at['_notebooks']]
        return none
    f = magpie.scan[_at['_notebooks']]
    if not f.ok
        return none
    mine = f[f.notebook eq name]
    if not mine.ok
        return none
    changes = for s in mine.source
        _preview[text_of[s]]
    ats = for a in mine.at
        short_at[text_of[a]]
    states = for l in mine.live
        _state_of[l]
    shown = frame.new[version = mine._pos, at = ats, cell = mine.cell, state = states, change = changes, source = mine.source]
    return sort[shown, 'version', desc = true]

--- a version's cell as it was left: saved, or deleted by that version
fn _state_of[live]
    if live
        return 'saved'
    return 'deleted'

--- a moment written as ISO text, shown short: its date and time, in UTC
fn short_at[at]
    if len[at] lt 19
        return at
    return '`slice[at, 0, 10]` `slice[at, 11, 19]` UTC'

--- a cell's first line, cut to sixty characters, for a list of versions
fn _preview[source]
    first = split[source, '\n'][0]
    if len[split[source, '\n']] gt 1
        first = '`first` …'
    if len[first] gt 60
        return '`slice[first, 0, 60]`…'
    return first

--- a run written: what ran, when, who asked, how it went, and what it
--- printed; answers its position, the run's number
fn put_run[name, at, by, cells, status, ms, output]
    return magpie.batch[_at['_runs'], frame.new[notebook = [name], at = [at], by = [by], cells = [cells], status = [status], ms = [ms], output = [output]]]

--- every run, newest first (a notebook's alone where `name` is given)
fn runs[name]
    empty = frame.new[run = [0], notebook = [''], at = [''], by = [''], cells = [0], status = [''], ms = [0]]
    none = empty[empty.run lt 0]
    if _empty[_at['_runs']]
        return none
    f = magpie.latest[_at['_runs']]
    if not f.ok
        return none
    ats = for a in f.at
        short_at[text_of[a]]
    shown = frame.new[run = f._pos, notebook = f.notebook, at = ats, by = f.by, cells = f.cells, status = f.status, ms = f.ms]
    if name ne ''
        shown = shown[shown.notebook eq name]
    return sort[shown, 'run', desc = true]

--- what a run printed, by its number
fn run_output[run]
    v = _run_output[run]
    if not v.ok
        return ''
    return v

fn _run_output[run]
    if _empty[_at['_runs']]
        return ''
    f = magpie.latest[_at['_runs']]
    if not f.ok
        return ''
    one = f[f._pos eq run]
    if not one.ok
        return ''
    if len[one] eq 0
        return ''
    found = ''
    for c in one.output
        found = text_of[c]
    return found

--- when a notebook last ran by its schedule, or '' where it never did
fn last_scheduled[name]
    v = _last_scheduled[name]
    if not v.ok
        return ''
    return v

fn _last_scheduled[name]
    if _empty[_at['_runs']]
        return ''
    f = magpie.latest[_at['_runs']]
    if not f.ok
        return ''
    mine = f[f.notebook eq name]
    if not mine.ok
        return ''
    timed = mine[mine.by eq 'schedule']
    if not timed.ok
        return ''
    if len[timed] eq 0
        return ''
    newest = sort[timed, '_pos', desc = true]
    found = ''
    for c in head[newest, 1].at
        found = text_of[c]
    return found

--- a notebook's schedule: every how many seconds it runs (0, never) and
--- since when
fn put_schedule[name, every, since]
    return magpie.batch[_at['_schedules'], frame.new[notebook = [name], every = [every], since = [since]], by = ['notebook']]

fn every[name]
    v = _every[name]
    if not v.ok
        return 0
    return v

fn _every[name]
    if _empty[_at['_schedules']]
        return 0
    f = magpie.latest[_at['_schedules']]
    if not f.ok
        return 0
    mine = f[f.notebook eq name]
    if not mine.ok
        return 0
    if len[mine] eq 0
        return 0
    found = 0
    for c in mine.every
        found = small[c]
    return found

fn since[name]
    v = _since[name]
    if not v.ok
        return ''
    return v

fn _since[name]
    if _empty[_at['_schedules']]
        return ''
    f = magpie.latest[_at['_schedules']]
    if not f.ok
        return ''
    mine = f[f.notebook eq name]
    if not mine.ok
        return ''
    if len[mine] eq 0
        return ''
    found = ''
    for c in mine.since
        found = text_of[c]
    return found

--- the notebooks that run on a schedule
fn scheduled[]
    v = _scheduled[]
    if not v.ok
        return []
    return v

fn _scheduled[]
    found = []
    if _empty[_at['_schedules']]
        return found
    f = magpie.latest[_at['_schedules']]
    if not f.ok
        return found
    timed = f[f.every gt 0]
    if not timed.ok
        return found
    found = for n in timed.notebook
        text_of[n]
    return found

--- when a scheduled notebook is next due: its interval after its last
--- scheduled run, or after the schedule was set where it never ran
fn due[name]
    gap = every[name]
    if gap lte 0
        return ''
    last = last_scheduled[name]
    if last eq ''
        last = since[name]
    if last eq ''
        return ''
    t = moment[last]
    if not t.ok
        return ''
    return str[t + gap]

--- a setting, or its default where none was written
fn setting[key, default]
    v = _setting[key, default]
    if not v.ok
        return default
    return v

fn _setting[key, default]
    if _empty[_at['_settings']]
        return default
    f = magpie.latest[_at['_settings']]
    if not f.ok
        return default
    mine = f[f.key eq key]
    if not mine.ok
        return default
    if len[mine] eq 0
        return default
    found = default
    for c in mine.value
        found = text_of[c]
    return found

fn put_setting[key, value]
    return magpie.batch[_at['_settings'], frame.new[key = [key], value = [value]], by = ['key']]

--- a table's folder in the workspace, as Magpie's verbs take it
fn at[name]
    return _at[name]

--- a query's field, '' where the map lacks it
fn _got[q, key]
    if key not in q
        return ''
    return q[key]

--- a saved query, keyed by its name: what it asks, as the Query page's
--- fields hold it (each text); a query removed is written with live false
fn put_query[name, q, at, live]
    return magpie.batch[_at['_queries'], frame.new[name = [name], verb = [_got[q, 'verb']], table = [_got[q, 'table']], by = [_got[q, 'by']], of = [_got[q, 'of']], how = [_got[q, 'how']], on = [_got[q, 'on']], op = [_got[q, 'op']], value = [_got[q, 'value']], words = [_got[q, 'words']], column = [_got[q, 'column']], k = [_got[q, 'k']], columns = [_got[q, 'columns']], at = [at], live = [live]], by = ['name']]

--- the saved queries, newest first: their names, what they ask and when
--- they were saved
fn saved_queries[]
    empty = frame.new[name = [''], verb = [''], table = [''], at = ['']]
    none = empty[empty.name eq 'none']
    v = _saved_queries[]
    if not v.ok
        return none
    return v

fn _saved_queries[]
    empty = frame.new[name = [''], verb = [''], table = [''], at = ['']]
    none = empty[empty.name eq 'none']
    if _empty[_at['_queries']]
        return none
    f = magpie.latest[_at['_queries']]
    if not f.ok
        return none
    alive = f[f.live eq true]
    if not alive.ok
        return none
    names = for c in alive.name
        text_of[c]
    verbs = for c in alive.verb
        text_of[c]
    tables = for c in alive.table
        text_of[c]
    ats = for c in alive.at
        text_of[c]
    shown = frame.new[name = names, verb = verbs, table = tables, at = ats]
    return sort[shown, 'at', desc = true]

--- one saved query's fields, as put_query took them; an empty map where
--- no live query has the name
fn saved_query[name]
    v = _saved_query[name]
    if not v.ok
        return map[verb = '']
    return v

fn _saved_query[name]
    found = map[verb = '']
    if _empty[_at['_queries']]
        return found
    f = magpie.latest[_at['_queries']]
    if not f.ok
        return found
    one = f[f.name eq name]
    if not one.ok
        return found
    alive = one[one.live eq true]
    if not alive.ok
        return found
    if len[alive] eq 0
        return found
    for key in ['verb', 'table', 'by', 'of', 'how', 'on', 'op', 'value', 'words', 'column', 'k', 'columns']
        for c in alive.`key`
            found = set[found, key, text_of[c]]
    return found

--- a dashboard, or one of its tiles, written to the _dashboards log keyed
--- by the dashboard and the tile: tile 0 is the dashboard itself (every
--- how many seconds the scheduler refreshes it, 0 never), 1 and on its
--- tiles (the saved query each shows, drawn as bars, a number or a table,
--- its title and its place); a removed one is written with live false
fn put_tile[dash, tile, query, draw, title, place, every, live, at]
    return magpie.batch[_at['_dashboards'], frame.new[dashboard = [dash], tile = [tile], query = [query], draw = [draw], title = [title], place = [place], every = [every], live = [live], at = [at]], by = ['dashboard', 'tile']]

--- the dashboards, by name
fn dashboards[]
    v = _dashboards[]
    if not v.ok
        return []
    return v

fn _dashboards[]
    found = []
    if _empty[_at['_dashboards']]
        return found
    f = magpie.latest[_at['_dashboards']]
    if not f.ok
        return found
    heads = f[f.tile eq 0]
    if not heads.ok
        return found
    alive = heads[heads.live eq true]
    if not alive.ok
        return found
    found = for n in alive.dashboard
        text_of[n]
    return sort[found]

--- a dashboard's tiles in their places: the tile's id, the saved query it
--- shows, how it is drawn, its title and its place
fn board_tiles[dash]
    empty = frame.new[tile = [0], query = [''], draw = [''], title = [''], place = [0]]
    none = empty[empty.tile lt 0]
    v = _board_tiles[dash]
    if not v.ok
        return none
    return v

fn _board_tiles[dash]
    empty = frame.new[tile = [0], query = [''], draw = [''], title = [''], place = [0]]
    none = empty[empty.tile lt 0]
    if _empty[_at['_dashboards']]
        return none
    f = magpie.latest[_at['_dashboards']]
    if not f.ok
        return none
    mine = f[f.dashboard eq dash]
    if not mine.ok
        return none
    alive = mine[mine.live eq true]
    if not alive.ok
        return none
    tiles = alive[alive.tile gt 0]
    if not tiles.ok
        return none
    ids = for c in tiles.tile
        small[c]
    asked = for c in tiles.query
        text_of[c]
    draws = for c in tiles.draw
        text_of[c]
    titles = for c in tiles.title
        text_of[c]
    places = for c in tiles.place
        small[c]
    shown = frame.new[tile = ids, query = asked, draw = draws, title = titles, place = places]
    return sort[shown, 'place']

--- every how many seconds a dashboard is refreshed by the scheduler, 0
--- where it is not
fn board_every[dash]
    v = _board_every[dash]
    if not v.ok
        return 0
    return v

fn _board_every[dash]
    if _empty[_at['_dashboards']]
        return 0
    f = magpie.latest[_at['_dashboards']]
    if not f.ok
        return 0
    mine = f[f.dashboard eq dash]
    if not mine.ok
        return 0
    head_row = mine[mine.tile eq 0]
    if not head_row.ok
        return 0
    found = 0
    for c in head_row.every
        found = small[c]
    return found

--- the id a new tile takes: one past every tile any dashboard ever held,
--- so a tile's kept answer is never another's
fn next_tile[]
    top = 0
    if _empty[_at['_dashboards']]
        return 1
    f = magpie.latest[_at['_dashboards']]
    if not f.ok
        return 1
    for c in f.tile
        if small[c] gt top
            top = small[c]
    return top + 1

--- where a tile's last answer is kept: a Parquet file beside the logs
--- (a folder whose name begins with a dot is no table)
fn tiles_dir[]
    return _at['.tiles']

fn tile_file[tile]
    return '`tiles_dir[]`/`tile`.parquet'

--- a tile's last refresh written to the _tiles log: when, why it has no
--- answer ('' where it has one) and how many rows the answer had
fn put_tile_answer[tile, at, problem, rows]
    return magpie.batch[_at['_tiles'], frame.new[tile = [tile], at = [at], problem = [problem], rows = [rows]], by = ['tile']]

--- every tile's last refresh: its id, when, why it has no answer, and
--- how many rows the answer had
fn tile_answers[]
    empty = frame.new[tile = [0], at = [''], problem = [''], rows = [0]]
    none = empty[empty.tile lt 0]
    v = _tile_answers[]
    if not v.ok
        return none
    return v

fn _tile_answers[]
    empty = frame.new[tile = [0], at = [''], problem = [''], rows = [0]]
    none = empty[empty.tile lt 0]
    if _empty[_at['_tiles']]
        return none
    f = magpie.latest[_at['_tiles']]
    if not f.ok
        return none
    ids = for c in f.tile
        small[c]
    ats = for c in f.at
        text_of[c]
    problems = for c in f.problem
        text_of[c]
    counts = for c in f.rows
        small[c]
    return frame.new[tile = ids, at = ats, problem = problems, rows = counts]

--- the tables in the workspace: every Magpie log under myna_data/, the
--- workspace's own (an underscore first) after the notebooks' tables
fn tables[]
    found = []
    entries = ls[home[]]
    if not entries.ok
        return found
    mine = []
    own = []
    for e in entries
        if not starts[e, '.']
            h = magpie.head[_at[e]]
            if h.ok
                if starts[e, '_']
                    own = push[own, e]
                else
                    mine = push[mine, e]
    return concat[mine, own]

--- a table's newest rows, as many as asked, and its size
fn table_rows[name, n]
    f = magpie.latest[_at[name]]
    if not f.ok
        return f
    return head[f, n]

fn table_count[name]
    f = magpie.latest[_at[name]]
    if not f.ok
        return 0
    return len[f]

fn table_columns[name]
    found = []
    f = magpie.latest[_at[name]]
    if not f.ok
        return found
    found = f.columns
    return found

test the_logs_hold_notebooks_runs_schedules_and_settings[]
    assert[scratch[], 'a test removes its workspace: run the tests with ./test.sh, which sets MYNA_DATA']
    gone = rm[home[]]
    ready[]
    assert[names[] eq []]
    w = put_cell['scratch', 0, 'log[1]', true, '2026-11-04T10:00:00Z']
    assert[w.ok]
    w = put_cell['scratch', 1, 'log[2]', true, '2026-11-04T10:00:01Z']
    w = put_cell['other', 0, 'log[3]', true, '2026-11-04T10:00:02Z']
    assert[names[] eq ['other', 'scratch']]
    assert[ids['scratch'] eq [0, 1]]
    assert[sources['scratch'] eq ['log[1]', 'log[2]']]
    w = put_cell['scratch', 0, '', false, '2026-11-04T10:00:03Z']
    assert[ids['scratch'] eq [1]]
    assert[next_id['scratch'] eq 2]
    assert[len[versions['scratch']] eq 3]
    w = put_cell['other', 0, '', false, '2026-11-04T10:00:04Z']
    assert[names[] eq ['scratch']]
    r = put_run['scratch', '2026-11-04T10:01:00Z', 'you', 1, 'ok', 12, '2']
    assert[r.ok]
    assert[len[runs['scratch']] eq 1]
    assert[len[runs['other']] eq 0]
    assert[run_output[r] eq '2']
    assert[last_scheduled['scratch'] eq '']
    s = put_schedule['scratch', 3600, '2026-11-04T10:00:00Z']
    assert[every['scratch'] eq 3600]
    assert[scheduled[] eq ['scratch']]
    assert[due['scratch'] eq '2026-11-04T11:00:00Z']
    r = put_run['scratch', '2026-11-04T11:00:05Z', 'schedule', 1, 'ok', 9, '2']
    assert[due['scratch'] eq '2026-11-04T12:00:05Z']
    assert[setting['workspace', 'myna'] eq 'myna']
    p = put_setting['workspace', 'lab']
    assert[setting['workspace', 'myna'] eq 'lab']
    assert[tables[] eq ['_notebooks', '_runs', '_schedules', '_settings']]
    gone = rm[home[]]
