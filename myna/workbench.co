--- The workbench around every page: the sidebar with the mark, the
--- workspace's name and the sections, and the top bar with where the page
--- is, the search over the workspace's notebooks and tables, and the
--- page's own actions. The screen asks for a sign-in where the workspace
--- has users and the reader has none, and shows a reader with no grant on
--- the open project that they have none (myna/access.co).
use web, ui
use myna.workspace
use myna.projects
use myna.access

sought = ''

--- the workspace's name (Settings), read from the settings log, a file:
--- saving it moves the derivation for every reader at once
derive place_name
    tick = now[]
    return workspace.setting['workspace', 'Myna']

--- the open project's name, '' where none is open (myna/projects.co):
--- the sidebar names it under the workspace's
derive project_name
    tick = now[]
    folder = projects.current[]
    if folder eq ''
        return ''
    return projects.project_of[folder].name

--- the notebooks and tables whose names, or whose cells, hold the text
--- searched for
fn _notebooks_holding[q]
    found = []
    for n in workspace.names[]
        hit = q in lower[n]
        for s in workspace.sources[n]
            if q in lower[s]
                hit = true
        if hit
            found = push[found, n]
    return found

fn _tables_holding[q]
    found = []
    for t in workspace.tables[]
        if q in lower[t]
            found = push[found, t]
    return found

derive found_notebooks
    q = lower[trim[sought]]
    if q eq ''
        return []
    return _notebooks_holding[q]

derive found_tables
    q = lower[trim[sought]]
    if q eq ''
        return []
    return _tables_holding[q]

fn clear_find[]
    sought = ''

view mark[]
    return row[
        p['"', color = 'accent', weight = 'bold', font = 'mono'],
        p['(o.o)', weight = 'bold', font = 'mono'],
        p['"', color = 'accent', weight = 'bold', font = 'mono'],
        gap = 'xs', align = 'center']

view side_link[name, icon_name, href, on]
    if on
        return a[row[icon[icon_name], name, gap = 's', align = 'center'], href = href, surface = 'card', border = true, pad = 's', radius = 'm', weight = 'bold']
    return a[row[icon[icon_name], name, gap = 's', align = 'center'], href = href, pad = 's', radius = 'm']

--- the workspace's name, and the open project's
view _place[]
    if project_name eq ''
        return p[place_name, color = 'muted', size = 'xs']
    return p['`place_name` · `project_name`', color = 'muted', size = 'xs']

view sidebar[section]
    return stack[
        row[mark[], stack[p['Myna', weight = 'bold'], _place[], gap = 'xs'], gap = 's', align = 'center'],
        side_link['Projects', 'home', '/projects', section eq 'Projects'],
        side_link['Catalog', 'table', '/catalog', section eq 'Catalog'],
        side_link['Query', 'search', '/query', section eq 'Query'],
        side_link['Code', 'edit', '/', section eq 'Code'],
        side_link['Dashboards', 'chart', '/dashboards', section eq 'Dashboards'],
        side_link['Experiments', 'flag', '/experiments', section eq 'Experiments'],
        side_link['Models', 'bookmark', '/models', section eq 'Models'],
        side_link['Ask', 'mail', '/ask', section eq 'Ask'],
        side_link['Jobs', 'clock', '/jobs', section eq 'Jobs'],
        _app_links[section],
        divider[],
        _admin_links[section],
        side_link['Settings', 'settings', '/settings', section eq 'Settings'],
        _reader_row[],
        gap = 'xs', pad = 'm', width = '236px', background = 'surface', class = 'side']

--- the app's own pages: the manifest's dashboards that name a page
--- (docs/platform.md, Myna as a package), listed after Myna's
derive app_pages
    tick = now[]
    return workspace.paged[]

view _app_link[b, section]
    return side_link[b.name, 'chart', b.page, section eq b.name]

view _app_links[section]
    if len[app_pages] eq 0
        return stack[]
    links = for b in app_pages
        _app_link[b, section]
    return stack[divider[], links, gap = 'xs']

--- the workspace's pages an admin has: its users and their grants
view _admin_links[section]
    if not access.is_admin
        return stack[]
    return stack[
        side_link['Users', 'user', '/users', section eq 'Users'],
        side_link['Access', 'lock', '/access', section eq 'Access'],
        gap = 'xs']

--- who is reading, their role, and the way out where they signed in
view _reader_row[]
    if access.signed_in
        return row[icon['user'], p['`access.reader_name` · `access.reader_role`', color = 'muted', size = 'xs'], access.sign_out_button[], gap = 's', align = 'center', wrap = true]
    return row[icon['user'], p['`access.reader_name` · `access.reader_role`', color = 'muted', size = 'xs'], gap = 's', align = 'center']

view _notebook_hit[name]
    return a[row[icon['edit'], name, gap = 's', align = 'center'], href = '/?current=`name`']

view _table_hit[name]
    return a[row[icon['table'], name, gap = 's', align = 'center'], href = '/catalog?picked=`name`']

--- what the search found, under the top bar while something is typed
view results[]
    if trim[sought] eq ''
        return stack[]
    books = for n in found_notebooks
        _notebook_hit[n]
    kept = for t in found_tables
        _table_hit[t]
    if len[books] + len[kept] eq 0
        return row[p['nothing in the workspace holds “`trim[sought]`”', color = 'muted', size = 's'], button['Clear', click = clear_find], justify = 'between', align = 'center', pad = 's', surface = 'card', border = true]
    return stack[
        row[p['Found', weight = 'bold', size = 's'], button['Clear', click = clear_find], justify = 'between', align = 'center'],
        row[p['Notebooks', color = 'muted', size = 's'], books, gap = 'm', wrap = true, align = 'center'],
        row[p['Tables', color = 'muted', size = 's'], kept, gap = 'm', wrap = true, align = 'center'],
        gap = 's', pad = 'm', surface = 'card', border = true]

view topbar[where, actions]
    return stack[
        row[
            p['`place_name` / `where`', color = 'muted', size = 'xs'],
            row[field['Search', sought, type = 'text'], actions, gap = 's', align = 'center', class = 'tools'],
            justify = 'between', align = 'center', below = 'phone', becomes = 'stack'],
        results[],
        gap = 's']

--- whether a section is the workspace's own, shown whatever the reader's
--- grant on the open project
fn _workspace_section[section]
    return section in ['Projects', 'Users', 'Access', 'Settings']

--- a page of the workbench: the sidebar, then the top bar over the
--- page's body — the sign-in form alone while the workspace asks for a
--- sign-in and the reader has none, and no access in place of the body
--- where the reader has no grant on the open project
view screen[section, where, actions, body]
    if access.needed and not access.signed_in
        return stack[title['Sign in · `place_name`'], access.sign_in_form[], pad = 'l', align = 'center', class = 'signin']
    shown = body
    if not access.may_read and not _workspace_section[section]
        shown = access.no_access[]
    return row[
        title['`where` · `place_name`'],
        sidebar[section],
        stack[topbar[where, actions], divider[], shown, gap = 'm', pad = 'm', fill = 'true', class = 'main'],
        gap = 'none', align = 'start', below = 'phone', becomes = 'stack', class = 'shell']

--- the top bar's action on the pages that are not the notebooks: a link
--- to the notebook page with its New notebook dialog open, drawn as the
--- button the notebook page has there
view new_notebook[]
    return a['New notebook', href = '/?naming=true', class = 'button']
