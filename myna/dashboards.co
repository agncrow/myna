--- Dashboards: saved queries (myna/queries.co) on one page as tiles, each
--- drawn as bars, a number or a table, refreshed by the page's Refresh or
--- by the scheduler every so many minutes. A dashboard and its tiles are
--- rows of the _dashboards log, each tile's last answer a file beside the
--- logs (myna/tiles.co); the page draws the kept answers and never asks a
--- query while it draws.
---
--- A dashboard of an open project's manifest may name a program: Run runs
--- it with the dashboard's parameters (each a `name=value` line, kept per
--- dashboard in the settings), compiled where the project's bin/ holds a
--- binary built from the sources as they are and interpreted otherwise,
--- keeps the run in _runs, and refreshes the tiles, whose queries read the
--- tables the program wrote (myna/projects.co).
use web, ui, frame, magpie
use myna.workspace
use myna.workbench
use myna.access
use myna.queries
use myna.tiles
use myna.projects

--- a tile as the page draws it: what it shows, its last answer (its
--- labels and numbers for bars and a number, the frame for a table) or
--- why it has none
struct Tile [tile, title, draw, query, problem, at, rows, labels, amounts, value_col, answer]

--- the dashboard asked for in the address
current = ''
--- the New dashboard dialog
naming = false
new_name = ''
--- the Add tile form
adding = false
add_query = ''
add_draw = 'bars'
add_title = ''
--- moved by every write, so the lists read again
changed = 0
--- the parameters being edited, and the dashboard they are for
editing_params = false
params_text = ''
params_for = ''
--- the output of the last run shown open
output_open = false

derive names
    seen = changed
    return workspace.dashboards[]

--- the page of the app's own that shows a dashboard, by its name (the
--- tabs link there instead of the tiles)
derive board_pages
    seen = changed
    found = map[]
    for b in workspace.paged[]
        found = set[found, b.name, b.page]
    return found

derive query_names
    seen = changed
    found = []
    for c in workspace.saved_queries[].name
        found = push[found, workspace.text_of[c]]
    return found

--- the dashboard shown: the one asked for, else the first
derive shown
    if current in names
        return current
    if len[names] gt 0
        return names[0]
    return ''

derive every
    seen = changed
    return workspace.board_every[shown]

--- the open project's folder, '' where none is open
derive project_folder
    seen = changed
    tick = now[]
    return projects.current[]

--- the shown dashboard as the open project's manifest has it: its
--- program ('' where it names none, or no project is open) and its
--- parameters
derive manifest_board
    seen = changed
    return workspace.board_named[shown]

derive board_program
    return manifest_board.program

--- how Run runs the program now: compiled where its binary is built from
--- the sources as they are, interpreted otherwise
derive run_mode
    seen = changed
    tick = now[]
    if board_program eq ''
        return ''
    if projects.fresh_binary[project_folder, board_program]
        return 'compiled'
    return 'interpreted'

--- the parameters a dashboard's program runs with: the ones saved for
--- it, else the manifest's defaults, a `name=value` line each
fn _defaults_text[b]
    lines = []
    for i in range[len[b.param_names]]
        lines = push[lines, '`b.param_names[i]`=`b.param_defaults[i]`']
    return join[lines, '\n']

fn _params_key[dash]
    return 'params · `dash`'

derive params_now
    seen = changed
    if board_program eq ''
        return ''
    return workspace.setting[_params_key[shown], _defaults_text[manifest_board]]

--- the dashboard's runs, newest first
derive board_runs
    seen = changed
    tick = now[]
    return workspace.runs[shown]

derive last_output
    seen = changed
    if len[board_runs] eq 0
        return ''
    r = workspace.small[board_runs.run[0]]
    return workspace.run_output[r]

--- a number a cell holds, 0 where it holds none
fn _number[c]
    n = float[c]
    if not n.ok
        return 0.0
    return n

fn _no_answer[tile, title, draw, query, problem, at]
    return Tile[tile, title, draw, query, problem, at, 0, [], [], '', frame.new[]]

--- a tile's kept answer read back: its first text column as the labels,
--- its first column of numbers as the amounts
fn _tile_of[tile, key, title, draw, asked, answers]
    --- (the tile's query, said as its verb and table: a view shows it
    --- without reading the files)
    q = workspace.saved_query[asked]
    verb = queries.field_of[q, 'verb']
    tbl = queries.field_of[q, 'table']
    query = '`verb` of `tbl`'
    at = ''
    problem = ''
    rows = 0
    mine = answers[answers.tile eq key]
    if mine.ok
        for c in mine.at
            at = workspace.text_of[c]
        for c in mine.problem
            problem = workspace.text_of[c]
        for c in mine.rows
            rows = workspace.small[c]
    if at eq ''
        return _no_answer[tile, title, draw, query, 'Not refreshed yet', at]
    if problem ne ''
        return _no_answer[tile, title, draw, query, problem, at]
    f = frame.load[workspace.tile_file[key]]
    if not f.ok
        return _no_answer[tile, title, draw, query, 'The answer is not kept: Refresh asks again', at]
    cols = f.columns
    kinds = f.dtypes
    label_col = ''
    value_col = ''
    for i in range[len[cols]]
        if cols[i] ne '_pos'
            if label_col eq '' and kinds[i] eq 'str'
                label_col = cols[i]
            if value_col eq '' and (kinds[i] eq 'int' or kinds[i] eq 'float')
                value_col = cols[i]
    labels = []
    amounts = []
    if label_col ne ''
        labels = for c in f.`label_col`
            workspace.text_of[c]
    if value_col ne ''
        amounts = for c in f.`value_col`
            _number[c]
    return Tile[tile, title, draw, query, '', at, rows, labels, amounts, value_col, f]

fn _board_of[dash]
    found = []
    if dash eq ''
        return found
    t = workspace.board_tiles[dash]
    answers = workspace.tile_answers[]
    ids = for c in t.tile
        workspace.small[c]
    asked = for c in t.query
        workspace.text_of[c]
    draws = for c in t.draw
        workspace.text_of[c]
    titles = for c in t.title
        workspace.text_of[c]
    for i in range[len[ids]]
        found = push[found, _tile_of[ids[i], workspace.tile_key[dash, titles[i]], titles[i], draws[i], asked[i], answers]]
    return found

--- the tiles drawn: read again as the clock moves, since the scheduler
--- refreshes them from a process of its own
derive board
    seen = changed
    tick = now[]
    return _board_of[shown]

fn ask_name[]
    naming = true
    new_name = ''

fn close_naming[]
    naming = false

fn create_board[]
    if not access.may_write
        notice['This needs an editor\'s grant on the open project']
        return
    name = trim[new_name]
    if name eq ''
        notice['Name the dashboard first']
        return
    if name in names
        notice['A dashboard called `name` exists']
        return
    w = tiles.make_board[name, 0]
    if not w.ok
        notice['The dashboard was not made: `w.reason`']
        return
    changed = changed + 1
    naming = false
    current = name

fn drop_board[]
    if not access.may_write
        notice['This needs an editor\'s grant on the open project']
        return
    name = shown
    w = tiles.remove_board[name]
    if not w.ok
        notice['The dashboard was not removed: `w.reason`']
        return
    changed = changed + 1
    current = ''
    notice['Removed `name` from the manifest']

fn open_adding[]
    adding = true
    add_title = ''
    if add_query eq '' and len[query_names] gt 0
        add_query = query_names[0]

fn close_adding[]
    adding = false

fn add_one[]
    if not access.may_write
        notice['This needs an editor\'s grant on the open project']
        return
    name = trim[add_query]
    if name eq ''
        notice['Pick a saved query']
        return
    title = trim[add_title]
    if title eq ''
        title = name
    t = tiles.add_tile[shown, name, add_draw, title]
    if not t.ok
        notice['The tile was not added: `t.reason`']
        return
    changed = changed + 1
    adding = false

fn drop_tile[tile]
    if not access.may_write
        notice['This needs an editor\'s grant on the open project']
        return
    w = tiles.remove_tile[shown, tile]
    if not w.ok
        notice['The tile was not removed: `w.reason`']
        return
    changed = changed + 1

fn earlier[tile]
    if not access.may_write
        notice['This needs an editor\'s grant on the open project']
        return
    w = tiles.move_tile[shown, tile, -1]
    if not w.ok
        notice['The tile was not moved: `w.reason`']
        return
    changed = changed + 1

fn later_place[tile]
    if not access.may_write
        notice['This needs an editor\'s grant on the open project']
        return
    w = tiles.move_tile[shown, tile, 1]
    if not w.ok
        notice['The tile was not moved: `w.reason`']
        return
    changed = changed + 1

fn refresh_now[]
    n = tiles.refresh[shown]
    changed = changed + 1
    notice['Refreshed `n` tiles']

fn refresh_every[seconds]
    if not access.may_write
        notice['This needs an editor\'s grant on the open project']
        return
    w = tiles.set_every[shown, seconds]
    if not w.ok
        notice['The refresh was not set: `w.reason`']
        return
    changed = changed + 1

fn edit_params[]
    params_text = params_now
    params_for = shown
    editing_params = true

fn close_params[]
    editing_params = false

fn default_params[]
    params_text = _defaults_text[manifest_board]

fn save_params[]
    if not access.may_write
        notice['This needs an editor\'s grant on the open project']
        return
    w = workspace.put_setting[_params_key[shown], params_text]
    if not w.ok
        notice['The parameters were not saved: `w.reason`']
        return
    editing_params = false
    changed = changed + 1

--- the dashboard's program run with its parameters (the ones being
--- edited, saved first), the run kept in _runs, and the tiles refreshed
fn run_board[]
    if not access.may_write
        notice['This needs an editor\'s grant on the open project']
        return
    prog = board_program
    if prog eq ''
        notice['This dashboard names no program to run: Refresh asks its queries again']
        return
    given = params_now
    if editing_params and params_for eq shown
        given = params_text
        w = workspace.put_setting[_params_key[shown], params_text]
        editing_params = false
    at = str[now[]]
    r = projects.run_program[project_folder, prog, split[given, '\n'], 900]
    status = 'ok'
    if r.status ne 0
        status = 'failed'
    kept = workspace.put_run[shown, at, 'dashboard', 0, status, r.ms, r.output]
    n = tiles.refresh[shown]
    changed = changed + 1
    secs = queries.shown_number[float[r.ms] / 1000.0]
    if r.status ne 0
        output_open = true
        notice['`prog` failed (exit `r.status`, `r.mode`, `secs` s): its output is under Run']
        return
    notice['Ran `prog` `r.mode` in `secs` s and refreshed `n` tiles']

fn toggle_output[]
    output_open = not output_open

view _labelled[label, child]
    return stack[p[label, size = 'xs', class = 'qlabel'], child, gap = 'xs']

view _bar[label, v, top]
    share = queries.share[v, top]
    return row[
        p[label, size = 'xs', width = '96px', class = 'tlabel'],
        stack[stack[width = '`share`%', class = 'bar'], fill = 'true', class = 'ttrack'],
        p[queries.shown_number[v], size = 'xs', font = 'mono', width = '64px', class = 'tvalue'],
        gap = 's', align = 'center']

view _bars[t]
    if t.value_col eq ''
        return p['the answer has no column of numbers to draw', color = 'muted', size = 's']
    n = len[t.amounts]
    if n gt 12
        n = 12
    top = 0.0
    for v in t.amounts
        if v gt top
            top = v
    bars = for i in range[n]
        _bar[_label_at[t.labels, i], t.amounts[i], top]
    if len[t.amounts] gt 12
        return stack[bars, p['the first 12 of `len[t.amounts]` rows', color = 'muted', size = 'xs'], gap = 'xs']
    return stack[bars, gap = 'xs']

fn _label_at[labels, i]
    if i lt len[labels]
        return labels[i]
    return '`i + 1`'

view _number_of[t]
    if len[t.amounts] eq 0
        return stack[p['`t.rows`', size = 'xl', weight = 'bold', font = 'mono'], p['rows', color = 'muted', size = 'xs'], gap = 'xs']
    said = t.value_col
    if t.rows gt 1
        said = '`said` · the first of `t.rows` rows'
    return stack[p[queries.shown_number[t.amounts[0]], size = 'xl', weight = 'bold', font = 'mono'], p[said, color = 'muted', size = 'xs'], gap = 'xs']

view _drawn[t]
    if t.problem ne ''
        return p[t.problem, color = 'down', size = 's']
    if t.draw eq 'number'
        return _number_of[t]
    if t.draw eq 'table'
        if len[t.answer] gt 200
            return stack[stack[table[head[t.answer, 200], hide = ['_pos'], sort = true], class = 'answer tall'], p['the first 200 of `len[t.answer]` rows', color = 'muted', size = 'xs'], gap = 'xs']
        return stack[table[t.answer, hide = ['_pos'], sort = true], class = 'answer tall']
    return _bars[t]

--- when the tile's answer was made, and from which saved query where its
--- title does not say
fn _caption[t]
    when = workspace.short_at[t.at]
    if t.at eq ''
        return 'from `t.query`'
    return 'from `t.query` · `when`'

--- a table is as wide as the dashboard: its columns need the room
fn _tile_class[t]
    if t.draw eq 'table'
        return 'tile widetile'
    return 'tile'

view _tile_card[t]
    return stack[
        row[
            p[t.title, weight = 'bold'],
            row[
                button['↑', click = earlier[t.tile], tip = 'Move earlier'],
                button['↓', click = later_place[t.tile], tip = 'Move later'],
                button['✕', click = drop_tile[t.tile], tip = 'Remove the tile', confirm = 'Remove this tile?'],
                gap = 'xs', class = 'tilebar'],
            justify = 'between', align = 'center', gap = 's'],
        _drawn[t],
        p[_caption[t], color = 'muted', size = 'xs'],
        gap = 's', pad = 'm', surface = 'card', border = true, class = _tile_class[t]]

--- the parameters as the program is handed them, on one line
fn _params_line[lines_text]
    given = []
    for line in split[lines_text, '\n']
        t = trim[line]
        if t ne ''
            given = push[given, t]
    if len[given] eq 0
        return 'no parameters'
    return join[given, ' · ']

view _run_state[]
    if run_mode eq 'compiled'
        return p['compiled: Run starts its binary in bin/', color = 'up', size = 'xs']
    return p['interpreted: bin/ holds no binary built from the sources as they are (Compile it on the Projects page)', color = 'muted', size = 'xs']

view _params_editor[]
    if not (editing_params and params_for eq shown)
        return stack[]
    return stack[
        p['a name=value line each; a blank value takes the program\'s own default', color = 'muted', size = 'xs'],
        stack[field['', params_text, lines = 8], class = 'wide mono'],
        row[
            button['Run with these', click = run_board, class = 'primary'],
            button['Save', click = save_params],
            button['Defaults', click = default_params, tip = 'The manifest\'s defaults'],
            button['Cancel', click = close_params, shortcut = 'escape'],
            gap = 's', wrap = true],
        gap = 's']

view _status_word[status]
    if status eq 'ok'
        return p['ok', color = 'up', size = 'xs', weight = 'bold']
    return p[status, color = 'down', size = 'xs', weight = 'bold']

view _output_box[]
    if not output_open
        return stack[]
    return scroll[pre[last_output, font = 'mono', size = 's'], height = '320px']

view _last_run[]
    if len[board_runs] eq 0
        return p['Not run from Myna yet: Run writes the tables its tiles show', color = 'muted', size = 'xs']
    at = workspace.text_of[board_runs.at[0]]
    status = workspace.text_of[board_runs.status[0]]
    secs = queries.shown_number[float[workspace.small[board_runs.ms[0]]] / 1000.0]
    label = 'Output'
    if output_open
        label = 'Hide output'
    return stack[
        row[p['last run', color = 'muted', size = 'xs'], _status_word[status], p['`at` · `secs` s', color = 'muted', size = 'xs'], button[label, click = toggle_output], gap = 's', align = 'center', wrap = true],
        _output_box[],
        gap = 's']

--- a dashboard of the open project's manifest that names a program: the
--- program, how Run runs it, its parameters and its last run
view _run_panel[]
    if board_program eq ''
        return stack[]
    return stack[
        row[
            stack[
                row[p['Program', color = 'muted', size = 'xs'], a[board_program, href = '/?current=`board_program`', font = 'mono', size = 's', tip = 'Open the program on the Code page'], gap = 's', align = 'center'],
                _run_state[],
                gap = 'xs'],
            row[
                button['Run', click = run_board, class = 'primary', tip = 'Run the program with these parameters, then refresh the tiles'],
                button['Parameters', click = edit_params, tip = 'The name=value lines the program is handed'],
                gap = 's'],
            justify = 'between', align = 'center', gap = 'm', wrap = true],
        p[_params_line[params_now], font = 'mono', size = 'xs'],
        _params_editor[],
        _last_run[],
        gap = 's', pad = 'm', surface = 'card', border = true, class = 'runpanel']

view _about[]
    if manifest_board.about eq ''
        return stack[]
    return p[manifest_board.about, color = 'muted', size = 's']

fn _every_label[seconds]
    if seconds eq 0
        return 'off'
    if seconds lt 3600
        return '`seconds / 60` min'
    if seconds lt 86400
        return '`seconds / 3600` h'
    return '`seconds / 86400` d'

view _every_button[seconds]
    if every eq seconds
        return button[_every_label[seconds], click = refresh_every[seconds], class = 'primary']
    return button[_every_label[seconds], click = refresh_every[seconds]]

view _controls[]
    return row[
        row[p['Refreshed by the scheduler', color = 'muted', size = 's'], _every_button[0], _every_button[60], _every_button[900], _every_button[3600], _every_button[86400], gap = 'xs', align = 'center', wrap = true],
        row[
            button['Refresh now', click = refresh_now, class = 'primary', tip = 'Ask every tile\'s query again'],
            button['Add tile', click = open_adding],
            button['Remove dashboard', click = drop_board, confirm = 'Remove this dashboard? Its tiles go with it.'],
            gap = 's', wrap = true],
        justify = 'between', align = 'center', gap = 'm', wrap = true]

view _adding[]
    if not adding
        return stack[]
    if len[query_names] eq 0
        return stack[
            p['There are no saved queries yet: save one on the Query page, then add it here.', size = 's'],
            row[a['Open Query', href = '/query'], button['Cancel', click = close_adding], gap = 's', align = 'center'],
            gap = 's', pad = 'm', surface = 'card', border = true]
    return stack[
        h2['Add a tile'],
        row[
            _labelled['Saved query', select[query_names, add_query]],
            _labelled['Drawn as', select[['bars', 'number', 'table'], add_draw]],
            field['Title', add_title, type = 'text'],
            gap = 'm', wrap = true, align = 'end'],
        row[button['Add', click = add_one, class = 'primary'], button['Cancel', click = close_adding, shortcut = 'escape'], gap = 's'],
        gap = 'm', pad = 'm', surface = 'card', border = true, class = 'qform']

--- the dashboards as tabs, each a link to its own address, the one shown
--- marked (the dashboard shown is the first where the address names none)
view _board_link[name]
    if name in board_pages
        return a[name, href = board_pages[name], class = 'boardtab']
    if name eq shown
        return a[name, href = '/dashboards?current=`name`', class = 'boardtab on']
    return a[name, href = '/dashboards?current=`name`', class = 'boardtab']

view _switcher[]
    links = for n in names
        _board_link[n]
    return row[links, gap = 'none', wrap = true, class = 'boardtabs']

view _tiles[]
    if len[board] eq 0
        return p['No tiles yet: Add tile shows a saved query here, or Pin one from the Query page.', color = 'muted', size = 's']
    cards = for t in board
        _tile_card[t]
    return grid[cards, columns = 3, gap = 'm', class = 'tiles']

view _first_page[]
    return stack[
        h2['No dashboards yet'],
        p['A dashboard shows saved queries side by side, each as bars, a number or a table, and the scheduler can refresh it every few minutes.', color = 'muted'],
        row[button['New dashboard', click = ask_name], gap = 's'],
        gap = 's', pad = 'l', surface = 'card', border = true, max_width = '640px']

view _naming[]
    return modal[
        stack[
            h2['New dashboard'],
            form[field['Name', new_name, type = 'text'], button['Create', class = 'primary'], submit = create_board],
            button['Cancel', click = close_naming, shortcut = 'escape'],
            gap = 'm', pad = 'l', class = 'naming'],
        open = naming]

view _body[]
    if shown eq ''
        return stack[row[h1['Dashboards'], gap = 's'], _first_page[], gap = 'm']
    return stack[
        row[h1['Dashboards'], p['saved queries side by side, refreshed on demand or on a schedule', color = 'muted', size = 's'], gap = 's', align = 'center', wrap = true],
        _switcher[],
        _about[],
        _run_panel[],
        _controls[],
        _adding[],
        _tiles[],
        gap = 'm', class = 'cells']

fn _where[name]
    if name eq ''
        return 'Dashboards'
    return 'Dashboards / `name`'

view render[]
    return stack[
        workbench.screen['Dashboards', _where[shown], button['New dashboard', click = ask_name], _body[]],
        _naming[]]

--- a dashboard is made, a saved query added as bars and as a number,
--- refreshed, moved and removed
test a_dashboard_shows_saved_queries_as_tiles[]
    assert[workspace.scratch[], 'a test removes its workspace: run the tests with ./test.sh, which sets MYNA_DATA']
    gone = rm[workspace.code[]]
    workspace.ready[]
    w = magpie.batch[workspace.at['orders'], frame.new[item = ['apples', 'pears', 'plums'], qty = [3, 5, 2], shop = ['north', 'south', 'north']], by = ['item']]
    s = workspace.put_query['by shop', map[verb = 'summary', table = 'orders', by = 'shop', of = 'qty', how = 'sum'], '2026-11-05T10:00:00Z', true]
    t = workspace.put_query['total', map[verb = 'summary', table = 'orders', by = '', of = 'qty', how = 'sum'], '2026-11-05T10:00:01Z', true]
    a = app[render, wide = true]
    assert['No dashboards yet' in html[a]]
    click[a, ask_name]
    change[a, 'new_name', 'Sales']
    click[a, create_board]
    assert[a.shown eq 'Sales']
    assert['No tiles yet' in html[a]]
    click[a, open_adding]
    change[a, 'add_query', 'by shop']
    change[a, 'add_title', 'Quantity by shop']
    click[a, add_one]
    click[a, open_adding]
    change[a, 'add_query', 'total']
    change[a, 'add_draw', 'number']
    click[a, add_one]
    drawn = html[a]
    assert['Quantity by shop' in drawn]
    assert['north' in drawn]
    assert['>10<' in drawn]
    assert[len[a.board] eq 2]
    assert[a.board[0].labels eq ['north', 'south']]
    click[a, earlier[2]]
    assert[a.board[0].title eq 'total']
    click[a, refresh_every[900]]
    assert[a.every eq 900]
    w = magpie.batch[workspace.at['orders'], frame.new[item = ['figs'], qty = [7], shop = ['east']], by = ['item']]
    click[a, refresh_now]
    assert['east' in html[a]]
    assert['>17<' in html[a]]
    click[a, drop_tile[2]]
    assert[len[a.board] eq 1]
    click[a, drop_board]
    assert['No dashboards yet' in html[a]]
    gone = rm[workspace.code[]]

--- a dashboard of the open project's manifest runs its program with its
--- parameters and shows the tables the run wrote
test a_program_dashboard_runs_and_shows_what_it_wrote[]
    if workspace.base[] ne 'myna_data'
        c = projects.close_project[]
    assert[workspace.scratch[], 'a test removes its workspace: run the tests with ./test.sh, which sets MYNA_DATA']
    gone = rm[workspace.code[]]
    workspace.ready[]
    folder = projects.test_project['proj']
    assert[folder.ok]
    opened = projects.open_folder['`folder`']
    assert[opened.ok]
    a = app[render, wide = true]
    assert[a.shown eq 'Hello']
    assert[a.board_program eq 'dashboards/hello.co']
    assert[a.run_mode eq 'interpreted']
    assert['who=world · times=3' in html[a]]
    assert['Not run from Myna yet' in html[a]]
    click[a, edit_params]
    change[a, 'params_text', 'who=crow\ntimes=4']
    click[a, run_board]
    drawn = html[a]
    assert['hello, crow (4)' in drawn]
    assert['>4<' in drawn]
    assert[a.params_now eq 'who=crow\ntimes=4']
    assert[len[a.board_runs] eq 1]
    click[a, toggle_output]
    assert['wrote 4 greetings to crow' in html[a]]
    done = projects.close_project[]
    assert[workspace.scratch[]]
    gone = rm[workspace.code[]]
