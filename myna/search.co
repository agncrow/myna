--- MLflow's search grammar, written in Crow: a filter of conditions
--- joined by AND, and an order of keys with ASC or DESC, read the same for
--- runs, experiments, registered models, versions and logged models.
---
---   metrics.rmse < 0.5 and params.model = 'ridge'
---   tags.`team name` ILIKE '%lab%' and attributes.status IN ('FINISHED')
---
--- The text is read into conditions and each is held to the values of an
--- entity, which the caller hands as a list of Field (kind, key, text,
--- number, whether it is a number). Nothing is ever pasted into a query.
--- What MLflow's issues taught: operators in any case, both quote marks,
--- backticked keys, numbers compared as numbers, NaN failing every
--- comparison and sorting last with what is missing, `IS NULL` and `OR`
--- refused with the reason, and a page token checked.
use myna.workspace
use myna.tracking
use myna.registry
use myna.traces

struct Tok [sort, text, key]
struct Cond [of, key, op, value, values, number, numeric]
struct Order [of, key, desc]
struct Field [of, key, text, number, numeric]
struct Got [present, text, number, numeric]
struct Page [rows, next]
struct RunPage [runs, next]
struct ExperimentPage [experiments, next]
struct ModelPage [models, next]
struct VersionPage [versions, next]
struct LoggedPage [logged, next]
struct TracePage [traces, next]

fn _bad[reason]
    return error[reason, 'invalid']

--- --------------------------------------------------------- reading

fn _word_char[c]
    return c in 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.:-'

fn _digit[c]
    return c in '0123456789'

--- the text read into tokens: a name (with the key it quotes, if any), a
--- string, a number, an operator, a bracket or a comma
fn tokens_of[source]
    found = []
    cs = split[source, '']
    n = len[cs]
    i = 0
    while i lt n
        c = cs[i]
        if c eq ' ' or c eq '\n' or c eq '\t' or c eq '\r'
            i = i + 1
        else
            if c eq '\'' or c eq '"'
                piece = []
                j = i + 1
                closed = false
                while j lt n and not closed
                    if cs[j] eq c
                        if j + 1 lt n and cs[j + 1] eq c
                            piece = push[piece, c]
                            j = j + 2
                        else
                            closed = true
                            j = j + 1
                    else
                        if cs[j] eq '\\' and j + 1 lt n
                            piece = push[piece, cs[j + 1]]
                            j = j + 2
                        else
                            piece = push[piece, cs[j]]
                            j = j + 1
                if not closed
                    return _bad['a string is not closed: `source`']
                found = push[found, Tok['str', join[piece, ''], '']]
                i = j
            else
                if c eq '\`'
                    piece = []
                    j = i + 1
                    while j lt n and cs[j] ne '\`'
                        piece = push[piece, cs[j]]
                        j = j + 1
                    if j gte n
                        return _bad['a backticked name is not closed: `source`']
                    found = push[found, Tok['quoted', join[piece, ''], '']]
                    i = j + 1
                else
                    if c in '()'
                        found = push[found, Tok[c, c, '']]
                        i = i + 1
                    else
                        if c eq ','
                            found = push[found, Tok[',', c, '']]
                            i = i + 1
                        else
                            if c in '=!<>'
                                j = i + 1
                                if j lt n and cs[j] eq '='
                                    j = j + 1
                                else
                                    if c eq '<' and j lt n and cs[j] eq '>'
                                        j = j + 1
                                said = join[slice[cs, i, j], '']
                                if said eq '!'
                                    return _bad['\'!\' alone is no operator in `source`']
                                if said eq '=='
                                    said = '='
                                if said eq '<>'
                                    said = '!='
                                found = push[found, Tok['op', said, '']]
                                i = j
                            else
                                if _word_char[c]
                                    j = i
                                    while j lt n and _word_char[cs[j]]
                                        j = j + 1
                                    w = join[slice[cs, i, j], '']
                                    if ends[w, '.'] and j lt n and (cs[j] eq '\`' or cs[j] eq '"')
                                        q = cs[j]
                                        k = j + 1
                                        piece = []
                                        while k lt n and cs[k] ne q
                                            piece = push[piece, cs[k]]
                                            k = k + 1
                                        if k gte n
                                            return _bad['a quoted key is not closed: `source`']
                                        found = push[found, Tok['name', slice[w, 0, len[w] - 1], join[piece, '']]]
                                        i = k + 1
                                    else
                                        if _number_text[w]
                                            found = push[found, Tok['num', w, '']]
                                        else
                                            found = push[found, Tok['name', w, '']]
                                        i = j
                                else
                                    return _bad['\'`c`\' cannot stand in a search: `source`']
    return found

fn _number_text[w]
    if w eq '' or w eq '-' or w eq '.'
        return false
    f = float[w]
    if not f.ok
        return false
    first = slice[w, 0, 1]
    return _digit[first] or first eq '-' or first eq '.'

--- the kind a prefix names, as MLflow spells them
fn kind_of_prefix[prefix]
    p = lower[prefix]
    if p in ['metric', 'metrics']
        return 'metric'
    if p in ['param', 'params', 'parameter', 'parameters']
        return 'param'
    if p in ['tag', 'tags']
        return 'tag'
    if p in ['attribute', 'attributes', 'attr', 'run']
        return 'attribute'
    if p in ['dataset', 'datasets']
        return 'dataset'
    if p in ['trace', 'traces']
        return 'attribute'
    if p in ['metadata', 'request_metadata']
        return 'metadata'
    return ''

--- a name read into its kind and key: `metrics.rmse`, `tags.a.b` (the key
--- holds the dots after the first), `metrics.`a b``, or a bare attribute
fn _named[t, bare_ok]
    if t.key ne ''
        k = kind_of_prefix[t.text]
        if k eq ''
            return _bad['\'`t.text`\' is not metrics, params, tags, attributes or datasets']
        return Field[k, t.key, '', 0.0, false]
    pieces = split[t.text, '.']
    if len[pieces] gte 2
        k = kind_of_prefix[pieces[0]]
        if k ne ''
            rest = join[slice[pieces, 1, len[pieces]], '.']
            if rest eq ''
                return _bad['\'`t.text`\' names no key']
            return Field[k, rest, '', 0.0, false]
    if bare_ok
        return Field['attribute', t.text, '', 0.0, false]
    return _bad['\'`t.text`\' needs a prefix: metrics., params., tags., attributes. or datasets.']

--- a filter read into its conditions; '' is no condition. `bare_ok` lets a
--- name stand without a prefix as an attribute (the registry's `name`)
fn read_filter[source, bare_ok]
    conds = []
    if trim[source] eq ''
        return conds
    ts = tokens_of[source]
    if not ts.ok
        return ts
    n = len[ts]
    i = 0
    while i lt n
        if ts[i].sort eq 'quoted'
            return _bad['a backticked name needs its prefix, as in metrics.\`a b\`']
        if ts[i].sort ne 'name'
            return _bad['a condition begins with a name, not \'`ts[i].text`\'']
        f = _named[ts[i], bare_ok]
        if not f.ok
            return f
        if i + 1 gte n
            return _bad['\'`ts[i].text`\' is compared with nothing']
        o = ts[i + 1]
        op = ''
        j = i + 2
        if o.sort eq 'op'
            op = o.text
        else
            if o.sort ne 'name'
                return _bad['\'`o.text`\' is no comparison']
            w = upper[o.text]
            if w eq 'IS'
                return _bad['IS NULL and IS NOT NULL are not supported: a missing value fails every comparison']
            if w eq 'LIKE' or w eq 'ILIKE' or w eq 'IN'
                op = w
            else
                if w eq 'NOT' and j lt n and ts[j].sort eq 'name' and upper[ts[j].text] eq 'IN'
                    op = 'NOT IN'
                    j = j + 1
                else
                    return _bad['\'`o.text`\' is no comparison: =, !=, <, <=, >, >=, LIKE, ILIKE, IN or NOT IN']
        if j gte n
            return _bad['\'`f.key`\' `op` has no value']
        if op eq 'IN' or op eq 'NOT IN'
            if ts[j].sort ne '('
                return _bad['`op` takes a list in brackets: (\'a\', \'b\')']
            vals = []
            j = j + 1
            going = true
            while going
                if j gte n
                    return _bad['a list in brackets is not closed']
                if ts[j].sort ne 'str' and ts[j].sort ne 'num'
                    return _bad['a list holds strings: \'`ts[j].text`\'']
                vals = push[vals, ts[j].text]
                j = j + 1
                if j gte n
                    return _bad['a list in brackets is not closed']
                if ts[j].sort eq ')'
                    going = false
                    j = j + 1
                else
                    if ts[j].sort ne ','
                        return _bad['items of a list are parted by commas']
                    j = j + 1
            conds = push[conds, Cond[f.of, f.key, op, '', vals, 0.0, false]]
        else
            v = ts[j]
            if v.sort eq 'num'
                conds = push[conds, Cond[f.of, f.key, op, v.text, [], float[v.text], true]]
            else
                if v.sort eq 'str'
                    if f.of eq 'metric'
                        return _bad['a metric is compared with a number, not \'`v.text`\'']
                    conds = push[conds, Cond[f.of, f.key, op, v.text, [], 0.0, false]]
                else
                    if v.sort eq 'name' and upper[v.text] eq 'NULL'
                        return _bad['IS NULL and IS NOT NULL are not supported: a missing value fails every comparison']
                    return _bad['\'`v.text`\' is no value: a string in quotes or a number']
            j = j + 1
        if j lt n
            if ts[j].sort ne 'name'
                return _bad['conditions are joined by AND, not \'`ts[j].text`\'']
            joiner = upper[ts[j].text]
            if joiner eq 'OR'
                return _bad['OR is not supported: conditions are joined by AND']
            if joiner ne 'AND'
                return _bad['conditions are joined by AND, not \'`ts[j].text`\'']
            j = j + 1
            if j gte n
                return _bad['AND joins nothing']
        i = j
    return conds

--- the order clauses read: `metrics.rmse DESC`, `name`, `start_time ASC`
fn read_order[clauses, bare_ok]
    found = []
    for clause in clauses
        if trim[clause] ne ''
            ts = tokens_of[clause]
            if not ts.ok
                return ts
            if len[ts] eq 0 or ts[0].sort ne 'name'
                return _bad['an order begins with a name: \'`clause`\'']
            f = _named[ts[0], bare_ok]
            if not f.ok
                return f
            down = false
            if len[ts] gt 2
                return _bad['an order is a name and ASC or DESC: \'`clause`\'']
            if len[ts] eq 2
                d = upper[ts[1].text]
                if d eq 'DESC'
                    down = true
                else
                    if d ne 'ASC'
                        return _bad['an order\'s direction is ASC or DESC, not \'`ts[1].text`\'']
            found = push[found, Order[f.of, f.key, down]]
    return found

--- ------------------------------------------------------- comparing

fn _nan[x]
    return x ne x

--- the values an entity holds for a kind and key; several where it has
--- several (a run's datasets)
fn _values[fields, kind, key]
    found = []
    for f in fields
        if f.of eq kind and f.key eq key
            found = push[found, f]
    return found

--- whether a text matches a LIKE pattern: % any run, _ one character
fn like[t, pattern]
    ts = split[t, '']
    ps = split[pattern, '']
    i = 0
    j = 0
    star = -1
    mark = 0
    n = len[ts]
    m = len[ps]
    while i lt n
        if j lt m and (ps[j] eq '_' or ps[j] eq ts[i])
            i = i + 1
            j = j + 1
        else
            if j lt m and ps[j] eq '%'
                star = j
                mark = i
                j = j + 1
            else
                if star gte 0
                    j = star + 1
                    mark = mark + 1
                    i = mark
                else
                    return false
    while j lt m and ps[j] eq '%'
        j = j + 1
    return j eq m

fn _held_text[f, c]
    if c.op eq '='
        return f.text eq c.value
    if c.op eq '!='
        return f.text ne c.value
    if c.op eq 'LIKE'
        return like[f.text, c.value]
    if c.op eq 'ILIKE'
        return like[lower[f.text], lower[c.value]]
    if c.op eq 'IN'
        return f.text in c.values
    if c.op eq 'NOT IN'
        return f.text not in c.values
    if c.op eq '<'
        return f.text lt c.value
    if c.op eq '<='
        return f.text lte c.value
    if c.op eq '>'
        return f.text gt c.value
    if c.op eq '>='
        return f.text gte c.value
    return false

fn _held_number[x, c]
    if _nan[x] or _nan[c.number]
        return false
    if c.op eq '='
        return x eq c.number
    if c.op eq '!='
        return x ne c.number
    if c.op eq '<'
        return x lt c.number
    if c.op eq '<='
        return x lte c.number
    if c.op eq '>'
        return x gt c.number
    if c.op eq '>='
        return x gte c.number
    return false

--- whether one value holds a condition
fn _held_by[f, c]
    if f.numeric
        if c.op in ['IN', 'NOT IN']
            return _held_text[Field[f.of, f.key, _number_shown[f.number], f.number, false], c]
        if not c.numeric
            if c.op in ['LIKE', 'ILIKE']
                return _held_text[Field[f.of, f.key, _number_shown[f.number], f.number, false], c]
            n = float[c.value]
            if not n.ok
                return false
            return _held_number[f.number, Cond[c.of, c.key, c.op, c.value, c.values, n, true]]
        return _held_number[f.number, c]
    if c.numeric and c.op not in ['LIKE', 'ILIKE', 'IN', 'NOT IN']
        n = float[f.text]
        if not n.ok
            return _held_text[f, c]
        return _held_number[n, c]
    return _held_text[f, c]

fn _number_shown[x]
    if _nan[x]
        return 'nan'
    if x lt 1000000000000000.0 and x gt -1000000000000000.0
        w = int[x]
        if float[w] eq x
            return '`w`'
    return '`x`'

--- whether an entity's values hold every condition: a value it lacks
--- fails, whatever the operator
fn holds_all[conds, fields]
    return holds_all_where[conds, fields, false]

--- the same, where `absent_differs` lets a value an entity lacks hold `!=`
--- and NOT IN, as the registry's search reads them (models that are not
--- prompts are found by `tags.mlflow.prompt.is_prompt != 'true'`)
fn holds_all_where[conds, fields, absent_differs]
    for c in conds
        vs = _values[fields, c.of, c.key]
        spared = len[vs] eq 0 and absent_differs and c.op in ['!=', 'NOT IN']
        if not spared and not _any_holds[vs, c]
            return false
    return true

fn _any_holds[vs, c]
    for f in vs
        if _held_by[f, c]
            return true
    return false

--- conditions checked against what an entity may be searched by: an
--- attribute it lacks is refused, as MLflow names it
fn check_attributes[conds, texts, numbers]
    for c in conds
        if c.of eq 'attribute'
            if c.key not in texts and c.key not in numbers
                every = join[concat[[texts, numbers]], ', ']
                return _bad['\'`c.key`\' is not an attribute that can be searched: `every`']
            if c.key in numbers and not c.numeric and c.op not in ['IN', 'NOT IN']
                n = float[c.value]
                if not n.ok
                    return _bad['the attribute \'`c.key`\' is a number, not \'`c.value`\'']
    return conds

fn check_order_attributes[orders, texts, numbers]
    for o in orders
        if o.of eq 'attribute' and o.key not in texts and o.key not in numbers
            return _bad['\'`o.key`\' is not an attribute that can order a search']
        if o.of eq 'dataset'
            return _bad['a search cannot be ordered by a dataset']
    return orders

--- -------------------------------------------------------- ordering

--- -1, 0 or 1: a before b under one order, what is missing or NaN last
fn _cmp_one[a, b, o]
    va = _values[a, o.of, o.key]
    vb = _values[b, o.of, o.key]
    am = len[va] eq 0
    bm = len[vb] eq 0
    if not am
        am = va[0].numeric and _nan[va[0].number]
    if not bm
        bm = vb[0].numeric and _nan[vb[0].number]
    if am and bm
        return 0
    if am
        return 1
    if bm
        return -1
    x = va[0]
    y = vb[0]
    r = 0
    if x.numeric and y.numeric
        if x.number lt y.number
            r = -1
        else
            if x.number gt y.number
                r = 1
    else
        if x.text lt y.text
            r = -1
        else
            if x.text gt y.text
                r = 1
    if o.desc
        return 0 - r
    return r

fn _cmp[a, b, orders]
    for o in orders
        r = _cmp_one[a, b, o]
        if r ne 0
            return r
    return 0

--- the positions of the entities in order: a stable merge sort, so the
--- caller's tie-breaks (put last in `orders`) decide what the rest leave
fn ordered[rows, orders]
    idx = range[len[rows]]
    return _merge_sort[idx, rows, orders]

fn _merge_sort[idx, rows, orders]
    n = len[idx]
    if n lte 1
        return idx
    mid = n / 2
    left = _merge_sort[slice[idx, 0, mid], rows, orders]
    right = _merge_sort[slice[idx, mid, n], rows, orders]
    out = []
    i = 0
    j = 0
    while i lt len[left] and j lt len[right]
        if _cmp[rows[right[j]], rows[left[i]], orders] lt 0
            out = push[out, right[j]]
            j = j + 1
        else
            out = push[out, left[i]]
            i = i + 1
    while i lt len[left]
        out = push[out, left[i]]
        i = i + 1
    while j lt len[right]
        out = push[out, right[j]]
        j = j + 1
    return out

--- --------------------------------------------------------- paging

--- where a page begins: '' is the first; a token this code did not write
--- is refused
fn page_start[token]
    if token eq ''
        return 0
    if not starts[token, 'myna-page-']
        return _bad['the page token \'`token`\' is not one a search gave']
    n = int[slice[token, 10, len[token]]]
    if not n.ok
        return _bad['the page token \'`token`\' is not one a search gave']
    if n lt 0
        return _bad['the page token \'`token`\' is not one a search gave']
    return workspace.small[n]

--- the positions on one page, and the token of the next ('' at the end)
fn page_of[order, start, most]
    n = len[order]
    size = most
    if size lte 0
        size = n
    stop = min[start + size, n]
    shown = []
    if start lt n
        shown = slice[order, start, stop]
    next = ''
    if stop lt n
        next = 'myna-page-`stop`'
    return Page[shown, next]

--- a value made a field
fn text_field[kind, key, value]
    return Field[kind, key, value, 0.0, false]

fn number_field[kind, key, value]
    return Field[kind, key, '', value, true]

test reading_holding_and_ordering[]
    c = read_filter['metrics.rmse < 0.5 and params.model = \'ridge\'', false]
    assert[len[c] eq 2]
    assert[c[0].of eq 'metric' and c[0].op eq '<' and c[0].number eq 0.5]
    assert[c[1].of eq 'param' and c[1].value eq 'ridge']
    q = read_filter['tags.\`team name\` ilike "%LAB%" AND attributes.status in (\'FINISHED\', \'KILLED\')', false]
    assert[q[0].key eq 'team name' and q[0].op eq 'ILIKE']
    assert[q[1].values eq ['FINISHED', 'KILLED']]
    assert[read_filter['metrics.a IS NULL', false].kind eq 'invalid']
    assert[read_filter['metrics.a > 1 or metrics.b > 1', false].kind eq 'invalid']
    assert[read_filter['metrics.a > \'x\'', false].kind eq 'invalid']
    assert[read_filter['rmse > 1', false].kind eq 'invalid']
    assert[read_filter['name = \'x\'', true][0].of eq 'attribute']
    assert[len[read_filter['  ', false]] eq 0]
    dotted = read_filter['tags.mlflow.runName = \'a\'', false]
    assert[dotted[0].key eq 'mlflow.runName']
    nan = 0.0 / 0.0
    a = [number_field['metric', 'rmse', 0.4], text_field['param', 'model', 'ridge'], text_field['tag', 'team name', 'the Lab']]
    b = [number_field['metric', 'rmse', nan], text_field['param', 'model', 'ridge']]
    d = [text_field['param', 'model', 'tree']]
    assert[holds_all[c, a]]
    assert[not holds_all[c, b]]
    assert[not holds_all[read_filter['metrics.rmse != 1', false], b]]
    assert[not holds_all[read_filter['params.model != \'x\'', false], [number_field['metric', 'rmse', 1.0]]]]
    assert[holds_all[read_filter['tags.\`team name\` LIKE \'%Lab\'', false], a]]
    assert[not holds_all[read_filter['tags.\`team name\` LIKE \'%lab\'', false], a]]
    assert[like['abc', 'a_c'] and like['abc', '%'] and not like['abc', 'a'] and like['', '%']]
    nums = [[number_field['attribute', 'start_time', 9.0]], [number_field['attribute', 'start_time', 10.0]]]
    assert[holds_all[read_filter['attributes.start_time > 9.5', false], nums[1]]]
    assert[not holds_all[read_filter['attributes.start_time > 9.5', false], nums[0]]]
    o = read_order[['metrics.rmse ASC'], false]
    assert[ordered[[a, b, d], o] eq [0, 1, 2]]
    od = read_order[['metrics.rmse desc'], false]
    assert[ordered[[b, d, a], od] eq [2, 0, 1]]
    assert[read_order[['metrics.rmse UP'], false].kind eq 'invalid']
    assert[page_start['nonsense'].kind eq 'invalid']
    p = page_of[[5, 6, 7], 0, 2]
    assert[p.rows eq [5, 6] and p.next eq 'myna-page-2']
    p2 = page_of[[5, 6, 7], page_start[p.next], 2]
    assert[p2.rows eq [7] and p2.next eq '']


--- ------------------------------------------------------- the finders

fn _orders_or_default[order_by, bare_ok, defaults]
    orders = read_order[order_by, bare_ok]
    if not orders.ok
        return orders
    kept = orders
    for d in defaults
        kept = push[kept, d]
    return kept

fn _tag_fields[fs, tf, id]
    out = fs
    mine = tf[tf.id eq id]
    if not mine.ok
        return out
    ks = tracking.texts_in[mine.key]
    vs = tracking.texts_in[mine.value]
    for i in range[len[ks]]
        out = push[out, text_field['tag', ks[i], vs[i]]]
    return out

--- a run's values as a search reads them
fn run_fields[r, pf, lf, tf, with_sets]
    fs = [text_field['attribute', 'run_id', r.id], text_field['attribute', 'run_name', r.name], text_field['attribute', 'status', r.status], text_field['attribute', 'user_id', r.user], text_field['attribute', 'artifact_uri', r.artifacts], text_field['attribute', 'lifecycle_stage', r.stage], number_field['attribute', 'start_time', float[r.start]], number_field['attribute', 'created', float[r.start]]]
    if r.finish gt 0
        fs = push[fs, number_field['attribute', 'end_time', float[r.finish]]]
    ps = pf[pf.run eq r.id]
    if ps.ok
        ks = tracking.texts_in[ps.key]
        vs = tracking.texts_in[ps.value]
        for i in range[len[ks]]
            fs = push[fs, text_field['param', ks[i], vs[i]]]
    ms = lf[lf.run eq r.id]
    if ms.ok
        ks = tracking.texts_in[ms.key]
        vs = tracking.floats_in[ms.value]
        for i in range[len[ks]]
            fs = push[fs, number_field['metric', ks[i], vs[i]]]
    fs = _tag_fields[fs, tf, r.id]
    if with_sets
        for d in tracking.inputs_of[r.id]
            fs = push[fs, text_field['dataset', 'name', d.name]]
            fs = push[fs, text_field['dataset', 'digest', d.digest]]
            fs = push[fs, text_field['dataset', 'context', d.context]]
    return fs

fn _wants[conds, of]
    for c in conds
        if c.of eq of
            return true
    return false

--- the runs of experiments a search finds: a filter, a view ('active',
--- 'deleted', 'all' or MLflow's words), an order, a page
fn find_runs[experiment_ids, filter, shown, order_by, most, token]
    conds = read_filter[filter, false]
    if not conds.ok
        return conds
    checked = check_attributes[conds, ['run_id', 'run_name', 'status', 'user_id', 'artifact_uri', 'lifecycle_stage'], ['start_time', 'end_time', 'created']]
    if not checked.ok
        return checked
    orders = _orders_or_default[order_by, false, [Order['attribute', 'start_time', true], Order['attribute', 'run_id', false]]]
    if not orders.ok
        return orders
    ok_orders = check_order_attributes[orders, ['run_id', 'run_name', 'status', 'user_id', 'artifact_uri', 'lifecycle_stage'], ['start_time', 'end_time', 'created']]
    if not ok_orders.ok
        return ok_orders
    start = page_start[token]
    if not start.ok
        return start
    pf = tracking.params_frame[]
    lf = tracking.latest_frame[]
    tf = tracking.tags_frame['run']
    sets = _wants[conds, 'dataset']
    kept = []
    rows = []
    for r in tracking.runs_in[experiment_ids, shown]
        fs = run_fields[r, pf, lf, tf, sets]
        if holds_all[conds, fs]
            kept = push[kept, r]
            rows = push[rows, fs]
    p = page_of[ordered[rows, orders], start, most]
    found = for i in p.rows
        kept[i]
    return RunPage[found, p.next]

fn find_experiments[filter, shown, order_by, most, token]
    conds = read_filter[filter, true]
    if not conds.ok
        return conds
    checked = check_attributes[conds, ['name', 'experiment_id', 'lifecycle_stage'], ['creation_time', 'last_update_time']]
    if not checked.ok
        return checked
    orders = _orders_or_default[order_by, true, [Order['attribute', 'creation_time', true]]]
    if not orders.ok
        return orders
    ok_orders = check_order_attributes[orders, ['name', 'experiment_id'], ['creation_time', 'last_update_time']]
    if not ok_orders.ok
        return ok_orders
    start = page_start[token]
    if not start.ok
        return start
    tf = tracking.tags_frame['experiment']
    kept = []
    rows = []
    for e in tracking.experiments_in[shown]
        fs = [text_field['attribute', 'name', e.name], text_field['attribute', 'experiment_id', e.id], text_field['attribute', 'lifecycle_stage', e.stage], number_field['attribute', 'creation_time', float[e.created]], number_field['attribute', 'last_update_time', float[e.updated]]]
        fs = _tag_fields[fs, tf, e.id]
        if holds_all[conds, fs]
            kept = push[kept, e]
            rows = push[rows, fs]
    p = page_of[ordered[rows, orders], start, most]
    found = for i in p.rows
        kept[i]
    return ExperimentPage[found, p.next]

fn find_models[filter, order_by, most, token]
    conds = read_filter[filter, true]
    if not conds.ok
        return conds
    checked = check_attributes[conds, ['name'], ['creation_timestamp', 'last_updated_timestamp']]
    if not checked.ok
        return checked
    orders = _orders_or_default[order_by, true, [Order['attribute', 'name', false]]]
    if not orders.ok
        return orders
    ok_orders = check_order_attributes[orders, ['name'], ['creation_timestamp', 'last_updated_timestamp']]
    if not ok_orders.ok
        return ok_orders
    start = page_start[token]
    if not start.ok
        return start
    tf = tracking.tags_frame['registered_model']
    kept = []
    rows = []
    for m in registry.models_all[]
        fs = [text_field['attribute', 'name', m.name], number_field['attribute', 'creation_timestamp', float[m.created]], number_field['attribute', 'last_updated_timestamp', float[m.updated]]]
        fs = _tag_fields[fs, tf, m.id]
        if holds_all_where[conds, fs, true]
            kept = push[kept, m]
            rows = push[rows, fs]
    p = page_of[ordered[rows, orders], start, most]
    found = for i in p.rows
        kept[i]
    return ModelPage[found, p.next]

fn find_versions[filter, order_by, most, token]
    conds = read_filter[filter, true]
    if not conds.ok
        return conds
    checked = check_attributes[conds, ['name', 'run_id', 'source_path', 'current_stage'], ['version_number', 'creation_timestamp', 'last_updated_timestamp']]
    if not checked.ok
        return checked
    orders = _orders_or_default[order_by, true, [Order['attribute', 'name', false], Order['attribute', 'version_number', true]]]
    if not orders.ok
        return orders
    ok_orders = check_order_attributes[orders, ['name', 'run_id', 'source_path', 'current_stage'], ['version_number', 'creation_timestamp', 'last_updated_timestamp']]
    if not ok_orders.ok
        return ok_orders
    start = page_start[token]
    if not start.ok
        return start
    tf = tracking.tags_frame['model_version']
    kept = []
    rows = []
    for m in registry.models_all[]
        for v in registry.versions_of[m.name]
            fs = [text_field['attribute', 'name', v.name], text_field['attribute', 'run_id', v.run], text_field['attribute', 'source_path', v.source], text_field['attribute', 'current_stage', v.stage], number_field['attribute', 'version_number', float[v.version]], number_field['attribute', 'creation_timestamp', float[v.created]], number_field['attribute', 'last_updated_timestamp', float[v.updated]]]
            mine = tf[tf.id eq m.id]
            if mine.ok
                one = mine[mine.sub eq '`v.version`']
                if one.ok
                    ks = tracking.texts_in[one.key]
                    vs = tracking.texts_in[one.value]
                    for i in range[len[ks]]
                        fs = push[fs, text_field['tag', ks[i], vs[i]]]
            if holds_all_where[conds, fs, true]
                kept = push[kept, v]
                rows = push[rows, fs]
    p = page_of[ordered[rows, orders], start, most]
    found = for i in p.rows
        kept[i]
    return VersionPage[found, p.next]

fn find_logged[experiment_ids, filter, order_by, most, token]
    conds = read_filter[filter, true]
    if not conds.ok
        return conds
    checked = check_attributes[conds, ['name', 'model_id', 'status', 'source_run_id', 'model_type'], ['creation_timestamp', 'last_updated_timestamp']]
    if not checked.ok
        return checked
    orders = _orders_or_default[order_by, true, [Order['attribute', 'creation_timestamp', true], Order['attribute', 'model_id', false]]]
    if not orders.ok
        return orders
    ok_orders = check_order_attributes[orders, ['name', 'model_id', 'status', 'source_run_id', 'model_type'], ['creation_timestamp', 'last_updated_timestamp']]
    if not ok_orders.ok
        return ok_orders
    start = page_start[token]
    if not start.ok
        return start
    pf = tracking.params_frame[]
    tf = tracking.tags_frame['logged_model']
    kept = []
    rows = []
    for m in tracking.logged_in[experiment_ids]
        fs = [text_field['attribute', 'name', m.name], text_field['attribute', 'model_id', m.id], text_field['attribute', 'status', m.status], text_field['attribute', 'source_run_id', m.run], text_field['attribute', 'model_type', m.model_type], number_field['attribute', 'creation_timestamp', float[m.created]], number_field['attribute', 'last_updated_timestamp', float[m.updated]]]
        ps = pf[pf.run eq m.id]
        if ps.ok
            ks = tracking.texts_in[ps.key]
            vs = tracking.texts_in[ps.value]
            for i in range[len[ks]]
                fs = push[fs, text_field['param', ks[i], vs[i]]]
        for x in tracking.model_metrics[m.id]
            fs = push[fs, number_field['metric', x.key, x.value]]
        fs = _tag_fields[fs, tf, m.id]
        if holds_all[conds, fs]
            kept = push[kept, m]
            rows = push[rows, fs]
    p = page_of[ordered[rows, orders], start, most]
    found = for i in p.rows
        kept[i]
    return LoggedPage[found, p.next]

fn find_traces[experiment_ids, filter, order_by, most, token]
    conds = read_filter[filter, true]
    if not conds.ok
        return conds
    checked = check_attributes[conds, ['status', 'state', 'name', 'trace_id', 'request_id', 'client_request_id'], ['timestamp_ms', 'timestamp', 'execution_time_ms']]
    if not checked.ok
        return checked
    orders = _orders_or_default[order_by, true, [Order['attribute', 'timestamp_ms', true], Order['attribute', 'trace_id', false]]]
    if not orders.ok
        return orders
    start = page_start[token]
    if not start.ok
        return start
    tf = tracking.tags_frame['trace']
    kept = []
    rows = []
    for t in traces.traces_in[experiment_ids]
        fs = [text_field['attribute', 'status', t.state], text_field['attribute', 'state', t.state], text_field['attribute', 'name', t.name], text_field['attribute', 'trace_id', t.id], text_field['attribute', 'request_id', t.id], text_field['attribute', 'client_request_id', t.client_request_id], number_field['attribute', 'timestamp_ms', float[t.began]], number_field['attribute', 'timestamp', float[t.began]], number_field['attribute', 'execution_time_ms', float[t.took]]]
        fs = _tag_fields[fs, tf, t.id]
        meta = json[t.metadata]
        if meta.ok
            for k in keys[meta]
                x = meta[k]
                if x.ok
                    fs = push[fs, text_field['metadata', '`k`', '`x`']]
        if holds_all[conds, fs]
            kept = push[kept, t]
            rows = push[rows, fs]
    p = page_of[ordered[rows, orders], start, most]
    found = for i in p.rows
        kept[i]
    return TracePage[found, p.next]

test finders_over_a_workspace[]
    assert[workspace.scratch[], 'a test removes its workspace: run the tests with ./test.sh, which sets MYNA_DATA']
    gone = rm[workspace.code[]]
    tracking.ready[]
    e = tracking.create_experiment['grid', '']
    made = for k in range[5]
        tracking.create_run[e, 'r`k`', 'ada', 1000 + k]
    for k in range[5]
        a = tracking.log_param[made[k].id, 'alpha', '`k`']
        m = tracking.log_metric[made[k].id, 'rmse', float[10 - k], 0]
    nan = tracking.log_metric[made[2].id, 'rmse', 0.0 / 0.0, 1]
    t = tracking.tag_run[made[1].id, 'keep', 'yes']
    p = find_runs[[e], 'metrics.rmse < 9', 'active', ['metrics.rmse ASC'], 0, '']
    names = for r in p.runs
        r.name
    assert[names eq ['r4', 'r3']]
    all_by = find_runs[[e], '', 'active', ['metrics.rmse DESC'], 0, '']
    order = for r in all_by.runs
        r.name
    assert[order eq ['r0', 'r1', 'r3', 'r4', 'r2']]
    first = find_runs[[e], '', 'active', [], 2, '']
    assert[len[first.runs] eq 2 and first.runs[0].name eq 'r4']
    second = find_runs[[e], '', 'active', [], 2, first.next]
    third = find_runs[[e], '', 'active', [], 2, second.next]
    seen = []
    for pg in [first, second, third]
        for r in pg.runs
            seen = push[seen, r.name]
    assert[sort[seen] eq ['r0', 'r1', 'r2', 'r3', 'r4']]
    assert[third.next eq '']
    assert[find_runs[[e], 'attributes.nonsense = \'x\'', 'active', [], 0, ''].kind eq 'invalid']
    assert[find_runs[[e], '', 'active', [], 0, 'bad'].kind eq 'invalid']
    assert[len[find_runs[[e], 'tags.keep = \'yes\'', 'active', [], 0, ''].runs] eq 1]
    assert[len[find_runs[[e], 'params.alpha IN (\'1\', \'3\')', 'active', [], 0, ''].runs] eq 2]
    assert[len[find_runs[[e], 'attributes.start_time >= 1003', 'active', [], 0, ''].runs] eq 2]
    xs = find_experiments['name LIKE \'gr%\'', 'active', [], 0, '']
    assert[len[xs.experiments] eq 1]
    mm = registry.create_model['one', '']
    pp = registry.register_prompt['two', 'hi {{x}}', '']
    plain = find_models['tags.\`mlflow.prompt.is_prompt\` != \'true\'', [], 0, '']
    assert[len[plain.models] eq 1 and plain.models[0].name eq 'one']
    v = registry.register[made[0].id, '', 'one']
    vs = find_versions['name = \'one\'', [], 0, '']
    assert[len[vs.versions] eq 1]
