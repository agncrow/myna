--- The sections not built yet: each says what it will be, and what to use
--- meanwhile, instead of a page that is not there.
use web, ui
use myna.workbench

view _soon[name, what, meanwhile]
    return workbench.screen[name, name, workbench.new_notebook[], stack[
        h1[name],
        stack[
            p['Not built yet', weight = 'bold'],
            p[what, color = 'muted'],
            p[meanwhile, color = 'muted'],
            row[a['Open the notebooks', href = '/'], gap = 's'],
            gap = 's', pad = 'l', surface = 'card', border = true, max_width = '640px'],
        gap = 'm']]

view ask[]
    return _soon['Ask', 'Questions about the workspace answered by a model that reads the tables and runs notebooks as tools.', 'Meanwhile a notebook cell can call a model through Crow\'s llm module.']
