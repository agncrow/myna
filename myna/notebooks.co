--- The notebook page: cells of Crow run top to bottom as one program,
--- under each cell what it printed, how it ended and how long it took.
--- Every save is a version of the cell in the notebooks log and every run
--- a row of the runs log, so History lists both and restores a version; a
--- schedule is kept for the scheduler (scheduler.co, started from Jobs).
--- The cells' outputs are the session's last run, by position: a change
--- to the cells' order or number forgets them.
use web, ui, frame
use myna.workspace
use myna.engine
use myna.workbench

current = ''
naming = false
new_name = ''
written = 0
editing = -1
draft = ''
history_open = false
run_open = -1
cell_out = []
cell_end = []
cell_ms = []
cell_ran = []
names_left = []
run_note = ''

--- the notebook shown: the one chosen where it still exists, else the
--- first, else none
fn _shown[chosen, names]
    if chosen ne ''
        if chosen in names
            return chosen
    if len[names] eq 0
        return ''
    return names[0]

--- the log is read again after every write; the runs and the schedule
--- on every refresh too, since the scheduler writes them
derive notebooks
    seen = written
    return workspace.names[]

derive shown
    seen = written
    return _shown[current, workspace.names[]]

derive cell_ids
    seen = written
    return workspace.ids[_shown[current, workspace.names[]]]

derive cell_sources
    seen = written
    return workspace.sources[_shown[current, workspace.names[]]]

derive versions
    seen = written
    return workspace.versions[_shown[current, workspace.names[]]]

derive runs
    seen = written
    tick = now[]
    return workspace.runs[_shown[current, workspace.names[]]]

derive every
    seen = written
    return workspace.every[_shown[current, workspace.names[]]]

derive next_due
    seen = written
    tick = now[]
    return workspace.due[_shown[current, workspace.names[]]]

derive reads
    seen = written
    return engine.reads[workspace.sources[_shown[current, workspace.names[]]]]

derive writes
    seen = written
    return engine.writes[workspace.sources[_shown[current, workspace.names[]]]]

fn _seconds[written_as]
    n = int[written_as]
    if not n.ok
        return 60
    m = n
    if m lt 1
        m = 60
    if m gt 3600
        m = 3600
    return m

derive limit
    seen = written
    return _seconds[workspace.setting['limit', '60']]

derive run_text
    if run_open lt 0
        return ''
    return engine.cleaned[workspace.run_output[run_open]]

--- where a cell stands among the notebook's, by its id; -1 where it is
--- not there
fn _position[cid, ids]
    found = -1
    for i in range[len[ids]]
        if ids[i] eq cid
            found = i
    return found

fn _source_of[cid, ids, srcs]
    found = ''
    for i in range[len[ids]]
        if ids[i] eq cid
            found = srcs[i]
    return found

--- a run's lists over the cells: the run's own for the cells it ran, the
--- earlier run's for the rest, `filler` where there is none
fn _merged[had, got, n, filler]
    found = []
    for i in range[n]
        if i lt len[got]
            found = push[found, got[i]]
        else
            if i lt len[had]
                found = push[found, had[i]]
            else
                found = push[found, filler]
    return found

fn _total[ms]
    total = 0
    for m in ms
        if m gt 0
            total = total + m
    if total lt 0
        total = 0
    if total gt 1000000000000000
        total = 1000000000000000
    return total

fn _forget_run[]
    cell_out = []
    cell_end = []
    cell_ms = []
    cell_ran = []
    names_left = []
    run_note = ''

--- the open cell's text saved as a new version where it changed
fn _keep_draft[]
    if editing lt 0
        return
    was = _source_of[editing, cell_ids, cell_sources]
    if was eq draft
        return
    w = workspace.put_cell[shown, editing, draft, true, str[now[]]]
    if not w.ok
        notice['The cell was not saved: `w.reason`']
        return
    written = written + 1

fn open_notebook[name]
    _keep_draft[]
    current = name
    editing = -1
    draft = ''
    _forget_run[]

fn ask_name[]
    naming = true
    new_name = ''

fn close_naming[]
    naming = false

fn create[]
    name = trim[new_name]
    if name eq ''
        notice['Name the notebook first']
        return
    if name in notebooks
        notice['A notebook called `name` exists: open it from the list']
        return
    _keep_draft[]
    w = workspace.put_cell[name, 0, '', true, str[now[]]]
    if not w.ok
        notice['The notebook was not saved: `w.reason`']
        return
    written = written + 1
    naming = false
    new_name = ''
    current = name
    _forget_run[]
    editing = 0
    draft = ''

fn delete_notebook[]
    name = shown
    if name eq ''
        return
    at = str[now[]]
    ids = cell_ids
    for c in ids
        w = workspace.put_cell[name, c, '', false, at]
    s = workspace.put_schedule[name, 0, at]
    written = written + 1
    current = ''
    editing = -1
    draft = ''
    _forget_run[]
    notice['`name` was deleted; its versions and runs stay in the logs']

fn add_cell[]
    _keep_draft[]
    name = shown
    if name eq ''
        notice['Create a notebook first']
        return
    nid = workspace.next_id[name]
    w = workspace.put_cell[name, nid, '', true, str[now[]]]
    if not w.ok
        notice['The cell was not added: `w.reason`']
        return
    written = written + 1
    _forget_run[]
    editing = nid
    draft = ''

fn edit[cid]
    _keep_draft[]
    editing = cid
    draft = _source_of[cid, cell_ids, cell_sources]

fn save[]
    _keep_draft[]
    editing = -1
    draft = ''

fn cancel[]
    editing = -1
    draft = ''

fn delete_cell[cid]
    if editing eq cid
        editing = -1
        draft = ''
    _keep_draft[]
    w = workspace.put_cell[shown, cid, '', false, str[now[]]]
    if not w.ok
        notice['The cell was not deleted: `w.reason`']
        return
    written = written + 1
    _forget_run[]

--- two cells' texts swapped: a cell moves by taking its neighbour's place
fn _swap[a, b]
    sa = _source_of[a, cell_ids, cell_sources]
    sb = _source_of[b, cell_ids, cell_sources]
    at = str[now[]]
    wa = workspace.put_cell[shown, a, sb, true, at]
    wb = workspace.put_cell[shown, b, sa, true, at]
    written = written + 1
    _forget_run[]

fn move_up[cid]
    _keep_draft[]
    editing = -1
    draft = ''
    ids = cell_ids
    pos = _position[cid, ids]
    if pos lte 0
        return
    _swap[ids[pos - 1], cid]

fn move_down[cid]
    _keep_draft[]
    editing = -1
    draft = ''
    ids = cell_ids
    pos = _position[cid, ids]
    if pos lt 0
        return
    if pos + 1 gte len[ids]
        return
    _swap[cid, ids[pos + 1]]

--- the cells before `upto` run as one program; what each printed, how it
--- ended and its milliseconds are kept for the cells it ran, and the run
--- is written to the runs log
fn _execute[upto]
    name = shown
    if name eq ''
        return
    srcs = cell_sources
    n = len[srcs]
    count = upto
    if count gt n
        count = n
    if count lte 0
        return
    file = '`engine.slug[name]`.page'
    r = engine.run[workspace.home[], file, engine.program[srcs, count], limit]
    if not r.ok
        notice['The notebook did not run: `r.reason`']
        return
    firsts = engine.starts_at[srcs, count]
    ended = engine.states[r.stdout, count, r.status, file, firsts]
    ms = engine.times[r.stdout, count]
    cell_out = _merged[cell_out, engine.outputs[r.stdout, count, file, firsts], n, '']
    cell_end = _merged[cell_end, ended, n, '']
    cell_ms = _merged[cell_ms, ms, n, -1]
    cell_ran = _merged[cell_ran, slice[srcs, 0, count], n, '']
    names_left = engine.kinds[r.stdout]
    total = _total[ms]
    how = engine.verdict[ended]
    kept = workspace.put_run[name, str[now[]], 'you', count, how, total, slice[r.stdout, 0, 100000]]
    written = written + 1
    if kept.ok
        run_note = 'run `kept` · `count` of `n` cells · `how` · `total` ms'
    else
        run_note = '`count` of `n` cells · `how` · `total` ms (not recorded: `kept.reason`)'

fn run_all[]
    _keep_draft[]
    _execute[len[cell_ids]]

fn run_to[cid]
    _keep_draft[]
    _execute[_position[cid, cell_ids] + 1]

fn schedule[seconds]
    name = shown
    if name eq ''
        return
    w = workspace.put_schedule[name, seconds, str[now[]]]
    if not w.ok
        notice['The schedule was not saved: `w.reason`']
        return
    written = written + 1
    if seconds eq 0
        notice['`name` runs only when you run it']
    else
        notice['`name` runs `_every_words[seconds]` while the scheduler runs (Jobs)']

fn open_history[]
    history_open = true

fn close_history[]
    history_open = false

fn show_run[run]
    run_open = run

fn close_run[]
    run_open = -1

--- a version of a cell made its text again, as a new version
fn restore[version]
    v = versions
    one = v[v.version eq version]
    if len[one] eq 0
        notice['There is no version `version`']
        return
    cell = workspace.small[one.cell[0]]
    w = workspace.put_cell[shown, cell, str[one.source[0]], true, str[now[]]]
    if not w.ok
        notice['The version was not restored: `w.reason`']
        return
    written = written + 1
    if editing eq cell
        editing = -1
        draft = ''
    _forget_run[]
    notice['The cell holds version `version` again']

fn _every_words[seconds]
    if seconds eq 900
        return 'every 15 minutes'
    if seconds eq 3600
        return 'every hour'
    if seconds eq 86400
        return 'every day'
    if seconds lte 0
        return 'only when run by hand'
    return 'every `seconds` seconds'

fn _took[ms]
    if ms lt 0
        return ''
    if ms lt 1000
        return '`ms` ms'
    return '`round[float[ms] / 100.0] / 10.0` s'

--- how a cell's last run ended, where it ran since its text last changed
fn _word_of[i, ended, ran, srcs]
    if i gte len[ended]
        return 'not run'
    if ended[i] eq ''
        return 'not run'
    if ran[i] ne srcs[i]
        return 'changed'
    return ended[i]

fn _when[at]
    t = moment[at]
    if not t.ok
        return at
    told = fmt[t, style = 'datetime']
    if not told.ok
        return at
    plain = told
    return '`plain` UTC'

view _word[word]
    if word eq 'ok'
        return p['ok', color = 'up', size = 's', weight = 'bold']
    if word eq 'error' or word eq 'refused' or word eq 'timeout'
        return p[word, color = 'down', size = 's', weight = 'bold']
    if word eq 'changed'
        return p['changed since it ran', color = 'accent', size = 's']
    return p[word, color = 'muted', size = 's']

view _output[i]
    if i gte len[cell_out]
        return stack[]
    if cell_out[i] eq ''
        if cell_end[i] eq 'ok'
            return p['printed nothing', color = 'muted', size = 's']
        return stack[]
    return stack[pre[cell_out[i], font = 'mono', size = 's'], background = 'bg', pad = 's', radius = 's']

view _source[source]
    if source eq ''
        return p['empty cell: Edit to write Crow', color = 'muted', size = 's']
    return pre[source, font = 'mono', size = 's']

view _cell_number[i, word, ms]
    return row[
        p['[`i + 1`]', font = 'mono', color = 'muted', size = 's'],
        _word[word],
        p[_took[ms], color = 'muted', size = 's'],
        gap = 's', align = 'center']

fn _ms_of[i, ms]
    if i lt len[ms]
        return ms[i]
    return -1

view _editor[i, cid, last]
    return stack[
        row[
            row[p['[`i + 1`]', font = 'mono', color = 'muted', size = 's'], p['editing', color = 'accent', size = 's', weight = 'bold'], gap = 's', align = 'center'],
            row[
                button['Run', click = run_to[cid], shortcut = 'ctrl+enter meta+enter', tip = 'Save, then run the cells down to this one (Ctrl+Enter)'],
                button['Save', click = save, shortcut = 'ctrl+s meta+s', tip = 'Save the cell (Ctrl+S)'],
                button['Cancel', click = cancel, shortcut = 'escape', tip = 'Forget the changes (Escape)'],
                button['Delete', click = delete_cell[cid], confirm = 'Delete cell [`i + 1`]? Its versions stay in History.'],
                gap = 'xs', align = 'center'],
            justify = 'between', align = 'center'],
        stack[field['', draft, lines = 10], class = 'code'],
        _output[i],
        gap = 's', pad = 'm', surface = 'card', border = true]

view _viewer[i, cid, source, last]
    return stack[
        row[
            _cell_number[i, _word_of[i, cell_end, cell_ran, cell_sources], _ms_of[i, cell_ms]],
            row[
                button['Run', click = run_to[cid], tip = 'Run the cells down to this one'],
                button['Edit', click = edit[cid]],
                button['↑', click = move_up[cid], tip = 'Move the cell up', disabled = i eq 0],
                button['↓', click = move_down[cid], tip = 'Move the cell down', disabled = i eq last],
                button['Delete', click = delete_cell[cid], confirm = 'Delete cell [`i + 1`]? Its versions stay in History.'],
                gap = 'xs', align = 'center'],
            justify = 'between', align = 'center'],
        _source[source],
        _output[i],
        gap = 's', pad = 'm', surface = 'card', border = true]

view cell_view[i]
    ids = cell_ids
    srcs = cell_sources
    last = len[ids] - 1
    if ids[i] eq editing
        return _editor[i, ids[i], last]
    return _viewer[i, ids[i], srcs[i], last]

view _choice[name]
    if name eq shown
        return button[name, click = open_notebook[name], weight = 'bold', surface = 'card', border = true]
    return button[name, click = open_notebook[name]]

view _chooser[]
    held = notebooks
    choices = for n in held
        _choice[n]
    return row[p['Notebooks', color = 'muted', size = 's', weight = 'bold'], row[choices, gap = 's', wrap = true], gap = 'm', align = 'center', wrap = true]

view _header[name]
    return row[
        row[h1[name], p['notebook', color = 'muted', size = 'xs'], gap = 's', align = 'center'],
        row[
            button['Run all', click = run_all, shortcut = 'ctrl+shift+enter meta+shift+enter', tip = 'Run every cell (Ctrl+Shift+Enter)'],
            dropdown[summary['Schedule'], stack[
                button['Only when run by hand', click = schedule[0]],
                button['Every 15 minutes', click = schedule[900]],
                button['Every hour', click = schedule[3600]],
                button['Every day', click = schedule[86400]],
                gap = 'xs', pad = 's'], side = 'right'],
            button['History', click = open_history],
            button['Delete notebook', click = delete_notebook, confirm = 'Delete the notebook `name`? Its versions and runs stay in the logs.'],
            gap = 's', align = 'center'],
        justify = 'between', align = 'center', wrap = true]

view _line[label, value]
    return stack[p[label, color = 'muted', size = 'xs', weight = 'bold'], p[value, size = 's'], gap = 'xs']

fn _listed[names, none]
    if len[names] eq 0
        return none
    return join[names, ', ']

fn _schedule_words[gap, due]
    if gap lte 0
        return 'only when run by hand'
    if due eq ''
        return _every_words[gap]
    return '`_every_words[gap]` · next `_when[due]`'

view _variable[pair]
    words = split[pair, ' ']
    return row[p[words[0], font = 'mono', size = 's'], p[join[slice[words, 1, len[words]], ' '], color = 'muted', size = 's'], justify = 'between']

view _variables[]
    if len[names_left] eq 0
        return p['run the notebook to see the names its cells leave', color = 'muted', size = 's']
    rows = for pair in names_left
        _variable[pair]
    return stack[rows, gap = 'xs']

view _last_run[]
    r = runs
    if len[r] eq 0
        return _line['Last run', 'never']
    return _line['Last run', 'run `r.run[0]` · `r.status[0]` · `r.ms[0]` ms · `r.at[0]` · by `r.by[0]`']

view _about[]
    v = versions
    return stack[
        h2['This notebook'],
        _line['Cells', '`len[cell_ids]`'],
        _line['Saved', '`len[v]` versions · each save a batch in _notebooks'],
        _line['Reads', _listed[reads, 'no table']],
        _line['Writes', _listed[writes, 'no table']],
        _line['Schedule', _schedule_words[every, next_due]],
        _last_run[],
        _line['Shared with', 'only you: Myna has no sign-in yet'],
        divider[],
        p['Variables', color = 'muted', size = 'xs', weight = 'bold'],
        _variables[],
        gap = 's', pad = 'm', surface = 'card', border = true, width = '300px']

view _runs_table[]
    r = runs
    if len[r] eq 0
        return p['no runs yet', color = 'muted', size = 's']
    return table[r, key = 'run', hide = ['notebook'], actions = map[Output = show_run], page = 10]

view _versions_table[]
    v = versions
    if len[v] eq 0
        return p['no versions yet', color = 'muted', size = 's']
    return table[v, key = 'version', hide = ['source'], actions = map[Restore = restore], confirm = map[Restore = 'Make the cell hold this version again?'], page = 10]

view _history[]
    return drawer[
        stack[
            row[h2['History'], button['Close', click = close_history, shortcut = 'escape'], justify = 'between', align = 'center'],
            p['Runs', color = 'muted', size = 'xs', weight = 'bold'],
            _runs_table[],
            p['Versions: every save of every cell', color = 'muted', size = 'xs', weight = 'bold'],
            _versions_table[],
            gap = 'm', pad = 'm'],
        open = history_open, side = 'right']

view _run_output[]
    return modal[
        stack[
            row[h2['Run `run_open`'], button['Close', click = close_run, shortcut = 'escape'], justify = 'between', align = 'center'],
            scroll[pre[run_text, font = 'mono', size = 's'], height = '420px'],
            gap = 'm', pad = 'l'],
        open = run_open gte 0]

view _naming[]
    return modal[
        stack[
            h2['New notebook'],
            form[field['Name', new_name, type = 'text'], button['Create'], submit = create],
            button['Cancel', click = close_naming, shortcut = 'escape'],
            gap = 'm', pad = 'l'],
        open = naming]

view _first_page[]
    return stack[
        h2['No notebooks yet'],
        p['A notebook is cells of Crow, run top to bottom as one program: each cell shows what it printed, how it ended and how long it took, and every save is kept in a Magpie log.', color = 'muted'],
        row[button['New notebook', click = ask_name], gap = 's'],
        gap = 's', pad = 'l', surface = 'card', border = true]

view _body[]
    name = shown
    if name eq ''
        return stack[_chooser[], _first_page[], gap = 'm']
    items = for i in range[len[cell_ids]]
        cell_view[i]
    return stack[
        _chooser[],
        _header[name],
        p[run_note, color = 'muted', size = 's'],
        row[
            stack[items, row[button['+ cell', click = add_cell, tip = 'Add a cell at the end'], gap = 's'], gap = 'm', fill = 'true', class = 'cells'],
            _about[],
            gap = 'm', align = 'start'],
        _run_output[],
        _history[],
        gap = 'm']

fn _where[name]
    if name eq ''
        return 'Notebooks'
    return 'Notebooks / `name`'

view render[]
    return stack[
        workbench.screen['Notebooks', _where[shown], button['New notebook', click = ask_name], _body[]],
        _naming[]]

--- a notebook is made, its cells written and run, what each printed shown
--- under it with how it ended, and the notebook read back from the log
test a_notebook_is_made_written_run_and_kept[]
    assert[workspace.scratch[], 'a test removes its workspace: run the tests with ./test.sh, which sets MYNA_DATA']
    gone = rm[workspace.home[]]
    workspace.ready[]
    a = app[render, wide = true]
    click[a, ask_name]
    assert[naming]
    change[a, 'new_name', 'scratch']
    click[a, create]
    assert[not naming]
    assert[notebooks eq ['scratch']]
    assert[editing eq 0]
    change[a, 'draft', 'use math\nxs = [1, 2, 3]\nlog[sum[xs]]']
    click[a, save]
    click[a, add_cell]
    assert[editing eq 1]
    change[a, 'draft', 'log[len[xs] * 100]']
    click[a, run_all]
    shown_html = html[a]
    assert['>6<' in shown_html]
    assert['>300<' in shown_html]
    assert[cell_end eq ['ok', 'ok']]
    assert[names_left eq ['xs array']]
    assert[len[runs] eq 1]
    assert[cell_sources eq ['use math\nxs = [1, 2, 3]\nlog[sum[xs]]', 'log[len[xs] * 100]']]
    b = app[render, wide = true]
    assert[b.cell_ids eq [0, 1]]
    gone = rm[workspace.home[]]

--- a cell writes a table with Magpie and the next cell reads it: the
--- program runs in the workspace's folder, so the table is a log beside
--- the workspace's own, and the side panel names it read and written
test a_cell_writes_a_table_the_next_reads[]
    assert[workspace.scratch[], 'a test removes its workspace: run the tests with ./test.sh, which sets MYNA_DATA']
    gone = rm[workspace.home[]]
    workspace.ready[]
    a = app[render, wide = true]
    click[a, ask_name]
    change[a, 'new_name', 'tables']
    click[a, create]
    change[a, 'draft', 'use magpie, frame\nw = magpie.batch[\'orders\', frame.new[item = [\'apples\', \'pears\'], qty = [3, 5]], by = [\'item\']]']
    click[a, save]
    click[a, add_cell]
    change[a, 'draft', 'log[len[magpie.latest[\'orders\']]]']
    click[a, run_all]
    assert[cell_end eq ['ok', 'ok']]
    assert['>2<' in html[a]]
    assert['orders' in workspace.tables[]]
    assert[writes eq ['orders']]
    assert[reads eq ['orders']]
    gone = rm[workspace.home[]]

--- a cell that stops shows the stop under it, naming its own line, and
--- the cells after it are skipped
test a_stop_shows_under_its_cell[]
    assert[workspace.scratch[], 'a test removes its workspace: run the tests with ./test.sh, which sets MYNA_DATA']
    gone = rm[workspace.home[]]
    workspace.ready[]
    a = app[render, wide = true]
    click[a, ask_name]
    change[a, 'new_name', 'broken']
    click[a, create]
    change[a, 'draft', 'xs = [1, 2, 3]']
    click[a, add_cell]
    change[a, 'draft', 'log[1]\nlog[xs[7]]']
    click[a, add_cell]
    change[a, 'draft', 'log[2]']
    click[a, run_all]
    assert[cell_end eq ['ok', 'error', 'skipped']]
    assert['runtime error: line 2: index 7 is out of range' in cell_out[1]]
    gone = rm[workspace.home[]]

--- a refusal is shown under the cell it names, as that cell's line
test a_refusal_shows_under_its_cell[]
    assert[workspace.scratch[], 'a test removes its workspace: run the tests with ./test.sh, which sets MYNA_DATA']
    gone = rm[workspace.home[]]
    workspace.ready[]
    a = app[render, wide = true]
    click[a, ask_name]
    change[a, 'new_name', 'refused']
    click[a, create]
    change[a, 'draft', 'log[1]']
    click[a, add_cell]
    change[a, 'draft', 'log[nosuch[1]]']
    click[a, run_all]
    assert[cell_end eq ['skipped', 'refused']]
    assert['line 1, column 5: undefined function' in cell_out[1]]
    gone = rm[workspace.home[]]

--- a cell moves, is deleted and comes back from History; a deleted id is
--- never taken again
test cells_move_are_deleted_and_restored[]
    assert[workspace.scratch[], 'a test removes its workspace: run the tests with ./test.sh, which sets MYNA_DATA']
    gone = rm[workspace.home[]]
    workspace.ready[]
    a = app[render, wide = true]
    click[a, ask_name]
    change[a, 'new_name', 'order']
    click[a, create]
    change[a, 'draft', 'log[\'a\']']
    click[a, add_cell]
    change[a, 'draft', 'log[\'b\']']
    click[a, save]
    click[a, move_up[1]]
    assert[cell_sources eq ['log[\'b\']', 'log[\'a\']']]
    click[a, delete_cell[0]]
    assert[cell_ids eq [1]]
    click[a, add_cell]
    assert[cell_ids eq [1, 2]]
    v = versions
    first_b = v[v.change eq 'log[\'b\']']
    click[a, restore[workspace.small[first_b.version[len[first_b] - 1]]]]
    assert[cell_ids eq [1, 2]]
    held = cell_sources
    assert[held[0] eq 'log[\'b\']']
    gone = rm[workspace.home[]]

--- a schedule is kept for the scheduler, and a notebook deleted leaves
--- the list
test a_notebook_is_scheduled_and_deleted[]
    assert[workspace.scratch[], 'a test removes its workspace: run the tests with ./test.sh, which sets MYNA_DATA']
    gone = rm[workspace.home[]]
    workspace.ready[]
    a = app[render, wide = true]
    click[a, ask_name]
    change[a, 'new_name', 'nightly']
    click[a, create]
    click[a, schedule[86400]]
    assert[every eq 86400]
    assert[workspace.scheduled[] eq ['nightly']]
    click[a, delete_notebook]
    assert[notebooks eq []]
    assert[workspace.scheduled[] eq []]
    gone = rm[workspace.home[]]

--- a name that exists, or none, is refused with a notice
test a_notebook_needs_a_new_name[]
    assert[workspace.scratch[], 'a test removes its workspace: run the tests with ./test.sh, which sets MYNA_DATA']
    gone = rm[workspace.home[]]
    workspace.ready[]
    a = app[render, wide = true]
    click[a, ask_name]
    click[a, create]
    assert[notebooks eq []]
    assert[naming]
    change[a, 'new_name', 'one']
    click[a, create]
    click[a, ask_name]
    change[a, 'new_name', 'one']
    click[a, create]
    assert[notebooks eq ['one']]
    gone = rm[workspace.home[]]
