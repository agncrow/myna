--- ----------------------------------------------------------- traces

fn api_trace_start[a]
    tracking.ready[]
    tr = a['trace']
    if not tr.ok
        return error['a trace is sent as {"trace": {"trace_info": …}}', 'invalid']
    info = tr.trace_info
    if not info.ok
        return error['a trace is sent as {"trace": {"trace_info": …}}', 'invalid']
    place = info.trace_location
    exp = ''
    if place.ok
        inner = place.mlflow_experiment
        if inner.ok
            exp = _s[inner, 'experiment_id']
    meta = _map_pairs[info, 'trace_metadata']
    pieces = for p in meta
        '`_q[p.key]`: `_q[p.value]`'
    joined = join[pieces, ', ']
    tags = _map_pairs[info, 'tags']
    name = ''
    for t in tags
        if t.key eq 'mlflow.traceName'
            name = t.value
    began = tracking.clock[]
    if _has[info, 'request_time']
        began = ms_of_iso[_s[info, 'request_time']]
    t = traces.record_trace[traces.TraceInfo[_s[info, 'trace_id'], exp, name, began, duration_ms[_s[info, 'execution_duration']], _s[info, 'state'], _s[info, 'request_preview'], _s[info, 'response_preview'], _s[info, 'client_request_id'], '{`joined`}', '', 'active']]
    if not t.ok
        return t
    rest = []
    for p in tags
        if p.key ne 'mlflow.artifactLocation' and p.key ne 'mlflow.trace.spansLocation'
            rest = push[rest, p]
    w = tracking.put_tags['trace', t.id, '', _keys_of[rest], _values_of[rest], true]
    if not w.ok
        return w
    return '{"trace": {"trace_info": `trace_info_json[traces.trace_of[t.id]]`}}'

fn _trace_held[id]
    t = traces.trace_of[id]
    if t.id eq ''
        return error['Trace with ID `id` not found.', 'missing']
    return t

fn api_trace_get[id]
    t = _trace_held[id]
    if not t.ok
        return t
    return '{"trace": {"trace_info": `trace_info_json[t]`}}'

fn api_trace_batch[ids]
    pieces = []
    for id in ids
        t = traces.trace_of[id]
        if t.id ne ''
            pieces = push[pieces, '{"trace_info": `trace_info_json[t]`}']
    return '{"traces": `_list_json[pieces]`}'

fn api_trace_search[a]
    exps = _texts[a, 'experiment_ids']
    for place in _items[a, 'locations']
        inner = place.mlflow_experiment
        if inner.ok
            exps = push[exps, _s[inner, 'experiment_id']]
    p = search.find_traces[exps, _s[a, 'filter'], _texts[a, 'order_by'], _most[a, 100], _s[a, 'page_token']]
    if not p.ok
        return p
    pieces = for t in p.traces
        trace_info_json[t]
    return _paged['traces', pieces, p.next]

fn api_trace_delete[a]
    ids = _texts[a, 'trace_ids']
    for id in _texts[a, 'request_ids']
        ids = push[ids, id]
    n = traces.delete_traces[_s[a, 'experiment_id'], ids, _int[a, 'max_timestamp_millis']]
    return '{"traces_deleted": `n`}'

fn api_trace_tag[id, a]
    t = _trace_held[id]
    if not t.ok
        return t
    w = tracking.set_tag['trace', id, '', _s[a, 'key'], _s[a, 'value']]
    if not w.ok
        return w
    return '{}'

fn api_trace_untag[id, key]
    t = _trace_held[id]
    if not t.ok
        return t
    w = tracking.delete_tag['trace', id, '', key]
    return '{}'

fn assessment_json[x]
    body = '"feedback": {"value": `x.value`}'
    if x.assessment_type eq 'expectation'
        body = '"expectation": {"value": `x.value`}'
    out = '{"assessment_id": `_q[x.id]`, "assessment_name": `_q[x.name]`, "trace_id": `_q[x.trace_id]`, "source": {"source_type": `_q[x.source_type]`, "source_id": `_q[x.source_id]`}, "create_time": `_q[iso_of[x.created]]`, "last_update_time": `_q[iso_of[x.created]]`, `body`'
    if x.rationale ne ''
        out = '`out`, "rationale": `_q[x.rationale]`'
    if x.span ne ''
        out = '`out`, "span_id": `_q[x.span]`'
    return '`out`}'

fn api_assessment_create[id, a]
    x = a.assessment
    if not x.ok
        return error['an assessment is sent as {"assessment": …}', 'invalid']
    sort_of = 'feedback'
    value = 'null'
    fb = x.feedback
    if fb.ok
        e = encode[fb.value]
        if e.ok
            value = e
    else
        ex = x.expectation
        if ex.ok
            sort_of = 'expectation'
            e2 = encode[ex.value]
            if e2.ok
                value = e2
    who = 'HUMAN'
    whose = ''
    src = x.source
    if src.ok
        who = _s[src, 'source_type']
        whose = _s[src, 'source_id']
    made = traces.assess[id, _s[x, 'assessment_name'], sort_of, value, who, whose, _s[x, 'rationale'], _s[x, 'span_id']]
    if not made.ok
        return made
    return '{"assessment": `assessment_json[made]`}'

fn api_assessment_get[id, aid]
    for x in traces.assessments_of[id]
        if x.id eq aid
            return '{"assessment": `assessment_json[x]`}'
    return error['Assessment with ID `aid` not found', 'missing']

fn api_assessment_delete[id, aid]
    w = traces.delete_assessment[id, aid]
    if not w.ok
        return w
    return '{}'

--- ---------------------------------------------------------- answers

fn error_code[sort_of]
    if sort_of eq 'missing'
        return 'RESOURCE_DOES_NOT_EXIST'
    if sort_of eq 'exists'
        return 'RESOURCE_ALREADY_EXISTS'
    if sort_of eq 'invalid'
        return 'INVALID_PARAMETER_VALUE'
    return 'INTERNAL_ERROR'

fn error_status[sort_of]
    if sort_of eq 'missing'
        return 404
    if sort_of eq 'exists' or sort_of eq 'invalid'
        return 400
    return 500

fn error_json[sort_of, reason]
    return '{"error_code": `_q[error_code[sort_of]]`, "message": `_q[reason]`}'

