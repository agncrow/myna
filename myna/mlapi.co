--- MLflow's REST API over Myna's parts, written in Crow: the requests
--- MLflow's own client makes, answered as MLflow 3.18 answers them (each
--- shape recorded from a running server). Each endpoint is a function of
--- the request's arguments — the JSON body, or the query of a GET, read as
--- one parsed value — answering the JSON text of its reply or a failure
--- whose kind names MLflow's error: 'missing' RESOURCE_DOES_NOT_EXIST (404),
--- 'exists' RESOURCE_ALREADY_EXISTS (400), 'invalid'
--- INVALID_PARAMETER_VALUE (400). The handlers below the endpoints turn
--- those into responses; main.co routes MLflow's paths to them.
use web
use myna.workspace
use myna.tracking
use myna.registry
use myna.search
use myna.traces

--- ------------------------------------------------------------ reading

--- a request's arguments as one parsed value: its JSON body, else its
--- query
fn args_of[body, query_json]
    clean = trim[body]
    if clean ne ''
        j = json[clean]
        if j.ok
            return j
    q = json[query_json]
    if q.ok
        return q
    return json['{}']

fn _s[a, key]
    v = a[key]
    if not v.ok
        return ''
    return '`v`'

fn _has[a, key]
    v = a[key]
    return v.ok

fn _int[a, key]
    t = _s[a, key]
    if t eq ''
        return 0
    n = int[t]
    if not n.ok
        f = float[t]
        if not f.ok
            return 0
        return workspace.small[int[f]]
    return workspace.small[n]

--- a number as MLflow's client writes one: NaN and the infinities as text
fn float_text[t]
    if t eq 'NaN' or t eq 'nan'
        return 0.0 / 0.0
    if t eq 'Infinity' or t eq 'inf'
        return 1.0 / 0.0
    if t eq '-Infinity' or t eq '-inf'
        return -1.0 / 0.0
    f = float[t]
    if not f.ok
        return 0.0 / 0.0
    return f

fn _float[a, key]
    return float_text[_s[a, key]]

fn _truth[a, key]
    t = lower[_s[a, key]]
    return t eq 'true' or t eq '1'

--- a list in the arguments, or none
fn _items[a, key]
    v = a[key]
    found = for x in range[0]
        a
    if not v.ok
        return found
    --- a guard narrows only where it leaves, and only a `while` goes on
    --- past an item: a failed item (JSON's null) is skipped
    i = 0
    while i lt len[v]
        x = v[i]
        i = i + 1
        if not x.ok
            continue
        found = push[found, x]
    return found

--- a field that is a list of text, or one text
fn _texts[a, key]
    found = []
    v = a[key]
    if not v.ok
        return found
    t = '`v`'
    if starts[trim[t], '[']
        i = 0
        while i lt len[v]
            x = v[i]
            i = i + 1
            if not x.ok
                continue
            found = push[found, '`x`']
        return found
    if t ne ''
        found = push[found, t]
    return found

--- key and value pairs, the last of a key winning
fn _pairs_in[a, key]
    found = []
    for t in _items[a, key]
        k = _s[t, 'key']
        vv = _s[t, 'value']
        kept = []
        for p in found
            if p.key ne k
                kept = push[kept, p]
        found = push[kept, tracking.Pair[k, vv]]
    return found

--- a map of text in the arguments as pairs: trace tags and metadata
fn _map_pairs[a, key]
    found = []
    v = a[key]
    if not v.ok
        return found
    for k in keys[v]
        if _has[v, k]
            found = push[found, tracking.Pair[k, _s[v, k]]]
    return found

fn _keys_of[ps]
    found = for p in ps
        p.key
    return found

fn _values_of[ps]
    found = for p in ps
        p.value
    return found

fn _need[t, what]
    if t eq ''
        return error['Missing value for required parameter \'`what`\'', 'invalid']
    return t

--- ------------------------------------------------------------ writing

fn _q[s]
    return tracking.quoted[s]

--- a number as JSON: NaN and the infinities as MLflow's client reads them
fn num_json[x]
    if x ne x
        return '"NaN"'
    if x eq 1.0 / 0.0
        return '"Infinity"'
    if x eq -1.0 / 0.0
        return '"-Infinity"'
    return '`x`'

fn _pairs_json[ps]
    pieces = for p in ps
        '{"key": `_q[p.key]`, "value": `_q[p.value]`}'
    joined = join[pieces, ', ']
    return '[`joined`]'

fn _map_json[ps]
    pieces = for p in ps
        '`_q[p.key]`: `_q[p.value]`'
    joined = join[pieces, ', ']
    return '{`joined`}'

fn _metric_json[m]
    return '{"key": `_q[m.key]`, "value": `num_json[m.value]`, "timestamp": `m.at`, "step": `m.step`}'

fn _list_json[pieces]
    joined = join[pieces, ', ']
    return '[`joined`]'

fn experiment_json[e]
    tags = tracking.tags_of['experiment', e.id, '']
    out = '{"experiment_id": `_q[e.id]`, "name": `_q[e.name]`, "artifact_location": `_q[e.location]`, "lifecycle_stage": `_q[e.stage]`, "last_update_time": `e.updated`, "creation_time": `e.created`'
    if len[tags] gt 0
        out = '`out`, "tags": `_pairs_json[tags]`'
    return '`out`}'

fn run_info_json[r]
    out = '{"run_uuid": `_q[r.id]`, "experiment_id": `_q[r.experiment]`, "run_name": `_q[r.name]`, "user_id": `_q[r.user]`, "status": `_q[r.status]`, "start_time": `r.start`'
    if r.finish gt 0
        out = '`out`, "end_time": `r.finish`'
    return '`out`, "artifact_uri": `_q[r.artifacts]`, "lifecycle_stage": `_q[r.stage]`, "run_id": `_q[r.id]`}'

fn _dataset_json[d]
    ctx = [tracking.Pair['mlflow.data.context', d.context]]
    return '{"tags": `_pairs_json[ctx]`, "dataset": {"name": `_q[d.name]`, "digest": `_q[d.digest]`, "source_type": `_q[d.source_type]`, "source": `_q[d.source]`, "schema": `_q[d.schema]`, "profile": `_q[d.profile]`}}'

fn run_json[r]
    data = []
    ms = for m in tracking.latest_of[r.id]
        _metric_json[m]
    if len[ms] gt 0
        data = push[data, '"metrics": `_list_json[ms]`']
    params = tracking.params_of[r.id]
    if len[params] gt 0
        data = push[data, '"params": `_pairs_json[params]`']
    tags = tracking.tags_of['run', r.id, '']
    if len[tags] gt 0
        data = push[data, '"tags": `_pairs_json[tags]`']
    sets = for d in tracking.inputs_of[r.id]
        _dataset_json[d]
    ins = '{}'
    if len[sets] gt 0
        ins = '{"dataset_inputs": `_list_json[sets]`}'
    ids = tracking.outputs_of[r.id]
    steps = tracking.output_steps[r.id]
    outs = '{}'
    if len[ids] gt 0
        made = for i in range[len[ids]]
            '{"model_id": `_q[ids[i]]`, "step": `steps[i]`}'
        outs = '{"model_outputs": `_list_json[made]`}'
    joined = join[data, ', ']
    return '{"info": `run_info_json[r]`, "data": {`joined`}, "inputs": `ins`, "outputs": `outs`}'

fn logged_json[m]
    tags = tracking.tags_of['logged_model', m.id, '']
    info = '{"model_id": `_q[m.id]`, "experiment_id": `_q[m.experiment]`, "name": `_q[m.name]`, "creation_timestamp_ms": `m.created`, "last_updated_timestamp_ms": `m.updated`, "artifact_uri": `_q[m.location]`, "status": `_q[m.status]`, "model_type": `_q[m.model_type]`, "source_run_id": `_q[m.run]`'
    if len[tags] gt 0
        info = '`info`, "tags": `_pairs_json[tags]`'
    data = []
    params = tracking.params_of[m.id]
    if len[params] gt 0
        data = push[data, '"params": `_pairs_json[params]`']
    ms = tracking.model_metrics[m.id]
    runs = tracking.model_metric_runs[m.id]
    if len[ms] gt 0
        pieces = for i in range[len[ms]]
            '{"key": `_q[ms[i].key]`, "value": `num_json[ms[i].value]`, "timestamp": `ms[i].at`, "step": `ms[i].step`, "model_id": `_q[m.id]`, "run_id": `_q[runs[i]]`}'
        data = push[data, '"metrics": `_list_json[pieces]`']
    joined = join[data, ', ']
    return '{"info": `info`}, "data": {`joined`}}'

fn version_json[v]
    number = '`v.version`'
    out = '{"name": `_q[v.name]`, "version": `_q[number]`, "creation_timestamp": `v.created`, "last_updated_timestamp": `v.updated`, "current_stage": `_q[v.stage]`, "description": `_q[v.description]`, "source": `_q[v.source]`, "run_id": `_q[v.run]`, "status": `_q[v.status]`'
    tags = tracking.tags_of['model_version', v.model, '`v.version`']
    if len[tags] gt 0
        out = '`out`, "tags": `_pairs_json[tags]`'
    out = '`out`, "run_link": ""'
    names = registry.aliases_for[v.name, v.version]
    if len[names] gt 0
        quoted_names = for n in names
            _q[n]
        out = '`out`, "aliases": `_list_json[quoted_names]`'
    return '`out`}'

fn _alias_json[x]
    number = '`x.version`'
    return '{"alias": `_q[x.alias]`, "version": `_q[number]`}'

fn model_json[m]
    out = '{"name": `_q[m.name]`, "creation_timestamp": `m.created`, "last_updated_timestamp": `m.updated`'
    if m.description ne ''
        out = '`out`, "description": `_q[m.description]`'
    latest = for v in registry.latest_versions[m.name, []]
        version_json[v]
    if len[latest] gt 0
        out = '`out`, "latest_versions": `_list_json[latest]`'
    tags = tracking.tags_of['registered_model', m.id, '']
    if len[tags] gt 0
        out = '`out`, "tags": `_pairs_json[tags]`'
    named = for x in registry.aliases_of[m.name]
        _alias_json[x]
    if len[named] gt 0
        out = '`out`, "aliases": `_list_json[named]`'
    return '`out`}'

--- a span of time in milliseconds as protobuf writes a duration
fn duration_text[ms]
    whole = ms / 1000
    part = ms - whole * 1000
    if part eq 0
        return '`whole`s'
    p = '`part`'
    while len[p] lt 3
        p = '0`p`'
    return '`whole`.`p`s'

fn duration_ms[t]
    clean = trim[t]
    if ends[clean, 's']
        clean = slice[clean, 0, len[clean] - 1]
    f = float[clean]
    if not f.ok
        return 0
    return workspace.small[int[f * 1000.0]]

fn iso_of[ms]
    return str[moment[float[ms] / 1000.0]]

fn ms_of_iso[t]
    m = moment[t]
    if not m.ok
        return tracking.clock[]
    return workspace.small[int[float[m] * 1000.0]]

--- a JSON object of text as pairs, none where the text is no object
fn _pairs_of_json[source]
    found = []
    j = json[source]
    if not j.ok
        return found
    for k in keys[j]
        if _has[j, k]
            found = push[found, tracking.Pair[k, _s[j, k]]]
    return found

fn trace_info_json[t]
    meta = _pairs_of_json[t.metadata]
    tags = tracking.tags_of['trace', t.id, '']
    out = '{"trace_id": `_q[t.id]`, "trace_location": {"type": "MLFLOW_EXPERIMENT", "mlflow_experiment": {"experiment_id": `_q[t.experiment]`}}, "request_time": `_q[iso_of[t.began]]`, "execution_duration": `_q[duration_text[t.took]]`, "state": `_q[t.state]`, "trace_metadata": `_map_json[meta]`, "tags": `_map_json[tags]`'
    if t.client_request_id ne ''
        out = '`out`, "client_request_id": `_q[t.client_request_id]`'
    return '`out`, "request_preview": `_q[t.request_preview]`, "response_preview": `_q[t.response_preview]`}'

fn _paged[key, pieces, next]
    out = '{"`key`": `_list_json[pieces]`'
    if next ne ''
        out = '`out`, "next_page_token": `_q[next]`'
    return '`out`}'

--- ------------------------------------------------------ experiments

fn _experiment_held[id]
    e = tracking.experiment[id]
    if e.id eq ''
        return error['No Experiment with id=`id` exists', 'missing']
    return e

fn api_experiment_create[a]
    tracking.ready[]
    name = _need[_s[a, 'name'], 'name']
    if not name.ok
        return name
    id = tracking.create_experiment[name, _s[a, 'artifact_location']]
    if not id.ok
        if id.kind eq 'exists'
            return error['Experiment(name=`name`) already exists.', 'exists']
        return id
    tags = _pairs_in[a, 'tags']
    t = tracking.put_tags['experiment', id, '', _keys_of[tags], _values_of[tags], true]
    if not t.ok
        return t
    return '{"experiment_id": `_q[id]`}'

fn api_experiment_get[a]
    tracking.ready[]
    e = _experiment_held[_s[a, 'experiment_id']]
    if not e.ok
        return e
    return '{"experiment": `experiment_json[e]`}'

fn api_experiment_by_name[a]
    tracking.ready[]
    name = _s[a, 'experiment_name']
    e = tracking.experiment_named[name]
    if e.id eq ''
        return error['Could not find experiment with name \'`name`\'', 'missing']
    return '{"experiment": `experiment_json[e]`}'

fn _most[a, default]
    if not _has[a, 'max_results']
        return default
    n = _int[a, 'max_results']
    if n lte 0
        return default
    return n

fn api_experiment_search[a]
    tracking.ready[]
    shown = _s[a, 'view_type']
    if shown eq ''
        shown = 'ACTIVE_ONLY'
    p = search.find_experiments[_s[a, 'filter'], shown, _texts[a, 'order_by'], _most[a, 1000], _s[a, 'page_token']]
    if not p.ok
        return p
    pieces = for e in p.experiments
        experiment_json[e]
    return _paged['experiments', pieces, p.next]

fn api_experiment_update[a]
    e = _experiment_held[_s[a, 'experiment_id']]
    if not e.ok
        return e
    w = tracking.rename_experiment[e.id, _s[a, 'new_name']]
    if not w.ok
        return w
    return '{}'

fn api_experiment_delete[a]
    e = _experiment_held[_s[a, 'experiment_id']]
    if not e.ok
        return e
    w = tracking.delete_experiment[e.id]
    if not w.ok
        return w
    return '{}'

fn api_experiment_restore[a]
    e = _experiment_held[_s[a, 'experiment_id']]
    if not e.ok
        return e
    w = tracking.restore_experiment[e.id]
    if not w.ok
        return w
    return '{}'

fn api_experiment_tag[a]
    e = _experiment_held[_s[a, 'experiment_id']]
    if not e.ok
        return e
    w = tracking.set_tag['experiment', e.id, '', _s[a, 'key'], _s[a, 'value']]
    if not w.ok
        return w
    return '{}'

fn api_experiment_untag[a]
    e = _experiment_held[_s[a, 'experiment_id']]
    if not e.ok
        return e
    w = tracking.delete_tag['experiment', e.id, '', _s[a, 'key']]
    if not w.ok
        return w
    return '{}'

--- ------------------------------------------------------------- runs

fn _run_id[a]
    id = _s[a, 'run_id']
    if id eq ''
        id = _s[a, 'run_uuid']
    return id

fn _run_held[a]
    id = _run_id[a]
    r = tracking.run[id]
    if r.id eq ''
        return error['Run with id=`id` not found', 'missing']
    return r

fn api_run_create[a]
    tracking.ready[]
    exp = _s[a, 'experiment_id']
    if exp eq ''
        exp = '0'
    tags = _pairs_in[a, 'tags']
    name = _s[a, 'run_name']
    rest = []
    for t in tags
        if t.key eq 'mlflow.runName'
            if name eq ''
                name = t.value
        else
            rest = push[rest, t]
    r = tracking.create_run[exp, name, _s[a, 'user_id'], _int[a, 'start_time']]
    if not r.ok
        return r
    w = tracking.put_tags['run', r.id, '', _keys_of[rest], _values_of[rest], true]
    if not w.ok
        return w
    k = tracking.touch_experiment[exp]
    return '{"run": `run_json[tracking.run[r.id]]`}'

fn api_run_get[a]
    r = _run_held[a]
    if not r.ok
        return r
    return '{"run": `run_json[r]`}'

fn api_run_update[a]
    r = _run_held[a]
    if not r.ok
        return r
    u = tracking.update_run[r.id, _s[a, 'status'], _int[a, 'end_time'], _s[a, 'run_name']]
    if not u.ok
        return u
    return '{"run_info": `run_info_json[tracking.run[r.id]]`}'

fn api_run_delete[a]
    r = _run_held[a]
    if not r.ok
        return r
    w = tracking.delete_run[r.id]
    return '{}'

fn api_run_restore[a]
    r = _run_held[a]
    if not r.ok
        return r
    w = tracking.restore_run[r.id]
    return '{}'

fn _metric_of[t]
    at = tracking.clock[]
    if _has[t, 'timestamp']
        at = _int[t, 'timestamp']
    return tracking.Metric[_s[t, 'key'], _float[t, 'value'], _int[t, 'step'], at]

fn api_log_metric[a]
    r = _run_held[a]
    if not r.ok
        return r
    w = tracking.log_metrics_of[r.id, [_metric_of[a]], _s[a, 'model_id']]
    if not w.ok
        return w
    return '{}'

fn api_log_param[a]
    r = _run_held[a]
    if not r.ok
        return r
    w = tracking.log_params_of[r.id, [_s[a, 'key']], [_s[a, 'value']]]
    if not w.ok
        return w
    return '{}'

fn api_set_tag[a]
    r = _run_held[a]
    if not r.ok
        return r
    key = _s[a, 'key']
    if key eq 'mlflow.runName'
        u = tracking.update_run[r.id, '', 0, _s[a, 'value']]
        if not u.ok
            return u
        return '{}'
    w = tracking.set_tag['run', r.id, '', key, _s[a, 'value']]
    if not w.ok
        return w
    return '{}'

fn api_delete_tag[a]
    r = _run_held[a]
    if not r.ok
        return r
    key = _s[a, 'key']
    if tracking.tag_value['run', r.id, '', key] eq ''
        return error['No tag with name: `key` in run with id `r.id`', 'missing']
    w = tracking.delete_tag['run', r.id, '', key]
    return '{}'

fn api_log_batch[a]
    r = _run_held[a]
    if not r.ok
        return r
    params = _pairs_in[a, 'params']
    p = tracking.log_params_of[r.id, _keys_of[params], _values_of[params]]
    if not p.ok
        return p
    ms = for t in _items[a, 'metrics']
        _metric_of[t]
    m = tracking.log_metrics_of[r.id, ms, '']
    if not m.ok
        return m
    tags = _pairs_in[a, 'tags']
    rest = []
    for t in tags
        if t.key eq 'mlflow.runName'
            u = tracking.update_run[r.id, '', 0, t.value]
        else
            rest = push[rest, t]
    w = tracking.put_tags['run', r.id, '', _keys_of[rest], _values_of[rest], true]
    if not w.ok
        return w
    return '{}'

fn api_log_inputs[a]
    r = _run_held[a]
    if not r.ok
        return r
    sets = []
    for x in _items[a, 'datasets']
        d = x.dataset
        if not d.ok
            return error['a dataset input is sent as {"dataset": …, "tags": […]}', 'invalid']
        ctx = ''
        for t in _pairs_in[x, 'tags']
            if t.key eq 'mlflow.data.context'
                ctx = t.value
        sets = push[sets, tracking.Dataset[_s[d, 'name'], _s[d, 'digest'], _s[d, 'source_type'], _s[d, 'source'], _s[d, 'schema'], _s[d, 'profile'], ctx]]
    w = tracking.log_inputs_of[r.id, sets]
    if not w.ok
        return w
    return '{}'

fn api_log_outputs[a]
    r = _run_held[a]
    if not r.ok
        return r
    ids = []
    steps = []
    for x in _items[a, 'models']
        ids = push[ids, _s[x, 'model_id']]
        steps = push[steps, _int[x, 'step']]
    w = tracking.log_outputs_of[r.id, ids, steps]
    if not w.ok
        return w
    return '{}'

fn api_run_search[a]
    tracking.ready[]
    shown = _s[a, 'run_view_type']
    if shown eq ''
        shown = 'ACTIVE_ONLY'
    p = search.find_runs[_texts[a, 'experiment_ids'], _s[a, 'filter'], shown, _texts[a, 'order_by'], _most[a, 1000], _s[a, 'page_token']]
    if not p.ok
        return p
    pieces = for r in p.runs
        run_json[r]
    return _paged['runs', pieces, p.next]

fn api_metric_history[a]
    r = _run_held[a]
    if not r.ok
        return r
    h = tracking.history[r.id, _s[a, 'metric_key']]
    start = search.page_start[_s[a, 'page_token']]
    if not start.ok
        return start
    p = search.page_of[range[len[h]], start, _most[a, 0]]
    pieces = for i in p.rows
        _metric_json[h[i]]
    if len[pieces] eq 0 and p.next eq ''
        return '{}'
    return _paged['metrics', pieces, p.next]

fn api_artifacts_list[a]
    r = _run_held[a]
    if not r.ok
        return r
    files = tracking.run_files[r.id, _s[a, 'path']]
    pieces = []
    for f in files
        if f.is_dir
            pieces = push[pieces, '{"path": `_q[f.path]`, "is_dir": true}']
        else
            pieces = push[pieces, '{"path": `_q[f.path]`, "is_dir": false, "file_size": `f.size`}']
    return '{"root_uri": `_q[r.artifacts]`, "files": `_list_json[pieces]`}'

--- ---------------------------------------------------- logged models

fn _logged_held[id]
    m = tracking.logged_model[id]
    if m.id eq ''
        return error['Logged model with ID \'`id`\' not found', 'missing']
    return m

fn api_logged_create[a]
    tracking.ready[]
    exp = _s[a, 'experiment_id']
    m = tracking.create_logged[exp, _s[a, 'name'], _s[a, 'source_run_id'], _s[a, 'model_type']]
    if not m.ok
        return m
    params = _pairs_in[a, 'params']
    p = tracking.log_params_of[m.id, _keys_of[params], _values_of[params]]
    if not p.ok
        return p
    tags = _pairs_in[a, 'tags']
