test the_api_answers_as_mlflow_does[]
    assert[workspace.scratch[], 'a test removes its workspace: run the tests with ./test.sh, which sets MYNA_DATA']
    gone = rm[workspace.code[]]
    missing = api_experiment_by_name[json['{"experiment_name": "nope"}']]
    assert[missing.kind eq 'missing']
    made = json[api_experiment_create[json['{"name": "check", "tags": [{"key": "team", "value": "a"}, {"key": "team", "value": "b"}]}']]]
    exp = '`made.experiment_id`'
    again = api_experiment_create[json['{"name": "check"}']]
    assert[again.kind eq 'exists']
    got = json[api_experiment_get[json['{"experiment_id": "`exp`"}']]]
    assert['`got.experiment.name`' eq 'check']
    assert['`got.experiment.tags[0].value`' eq 'b']
    r = json[api_run_create[json['{"experiment_id": "`exp`", "user_id": "ada", "start_time": 5, "tags": [{"key": "mlflow.runName", "value": "first"}, {"key": "mlflow.source.name", "value": "a.py"}]}']]]
    id = '`r.run.info.run_id`'
    assert['`r.run.info.run_name`' eq 'first']
    assert[api_log_param[json['{"run_id": "`id`", "key": "alpha", "value": "0.5"}']] eq '{}']
    changed = api_log_param[json['{"run_id": "`id`", "key": "alpha", "value": "0.6"}']]
    assert[changed.kind eq 'invalid']
    ks = for i in range[251]
        'k'
    long_key = join[ks, '']
    big = api_log_param[json['{"run_id": "`id`", "key": "`long_key`", "value": "1"}']]
    assert[big.kind eq 'invalid']
    m0 = api_log_metric[json['{"run_id": "`id`", "key": "loss", "value": 1.0, "timestamp": 0, "step": 0}']]
    m1 = api_log_metric[json['{"run_id": "`id`", "key": "loss", "value": "NaN", "timestamp": 7, "step": 1}']]
    h = json[api_metric_history[json['{"run_id": "`id`", "metric_key": "loss"}']]]
    assert[len[h.metrics] eq 2]
    assert['`h.metrics[0].timestamp`' eq '0']
    assert['`h.metrics[1].value`' eq 'NaN']
    none_yet = api_metric_history[json['{"run_id": "`id`", "metric_key": "never"}']]
    assert[none_yet eq '{}']
    b = api_log_batch[json['{"run_id": "`id`", "params": [{"key": "layers", "value": "3"}], "metrics": [{"key": "rmse", "value": 0.25, "timestamp": 9, "step": 0}], "tags": [{"key": "note", "value": "a\\nb \\"c\\" é"}]}']]
    assert[b eq '{}']
    whole = json[api_run_get[json['{"run_id": "`id`"}']]]
    note = ''
    for t in whole.run.data.tags
        if '`t.key`' eq 'note'
            note = '`t.value`'
    assert[note eq 'a\nb "c" é']
    assert[encode[whole.run.inputs] eq '{}']
    s = json[api_run_search[json['{"experiment_ids": ["`exp`"], "filter": "metrics.rmse < 1 and params.alpha = \'0.5\'", "order_by": ["metrics.rmse ASC"]}']]]
    assert[len[s.runs] eq 1]
    bad = api_run_search[json['{"experiment_ids": ["`exp`"], "filter": "metrics.rmse IS NULL"}']]
    assert[bad.kind eq 'invalid']
    u = json[api_run_update[json['{"run_id": "`id`", "status": "FINISHED", "end_time": 99}']]]
    assert['`u.run_info.status`' eq 'FINISHED']
    lm = json[api_logged_create[json['{"experiment_id": "`exp`", "name": "model", "source_run_id": "`id`", "params": [{"key": "alpha", "value": "0.5"}]}']]]
    mid = '`lm.model.info.model_id`'
    fin = json[api_logged_finalize[mid, json['{"status": "LOGGED_MODEL_READY"}']]]
    assert['`fin.model.info.status`' eq 'LOGGED_MODEL_READY']
    rm1 = json[api_model_create[json['{"name": "price"}']]]
    v = json[api_version_create[json['{"name": "price", "source": "models:/`mid`", "model_id": "`mid`"}']]]
    assert['`v.model_version.version`' eq '1']
    assert['`v.model_version.run_id`' eq id]
    al = api_alias_set[json['{"name": "price", "alias": "champion", "version": "1"}']]
    byal = json[api_alias_get[json['{"name": "price", "alias": "champion"}']]]
    assert['`byal.model_version.aliases[0]`' eq 'champion']
    uri = json[api_version_uri[json['{"name": "price", "version": "1"}']]]
    assert[ends['`uri.artifact_uri`', '/models/`mid`/artifacts']]
    p = json[api_model_create[json['{"name": "greet", "tags": [{"key": "mlflow.prompt.is_prompt", "value": "true"}]}']]]
    pv = json[api_version_create[json['{"name": "greet", "source": "dummy-source", "tags": [{"key": "mlflow.prompt.text", "value": "Hello {{name}}!"}]}']]]
    assert['`pv.model_version.version`' eq '1']
    found = json[api_model_search[json['{"filter": "tags.\`mlflow.prompt.is_prompt\` != \'true\'"}']]]
    assert[len[found.registered_models] eq 1]
    gm = json[api_model_get[json['{"name": "price"}']]]
    assert['`gm.registered_model.aliases[0].alias`' eq 'champion']
    dv = api_version_delete[json['{"name": "price", "version": "1"}']]
    gone_alias = api_alias_get[json['{"name": "price", "alias": "champion"}']]
    assert[gone_alias.kind eq 'missing']
    tr = json[api_trace_start[json['{"trace": {"trace_info": {"trace_id": "tr-abc", "trace_location": {"type": "MLFLOW_EXPERIMENT", "mlflow_experiment": {"experiment_id": "`exp`"}}, "request_time": "2026-11-06T22:34:56.762Z", "execution_duration": "1.5s", "state": "OK", "trace_metadata": {"mlflow.user": "ada"}, "tags": {"mlflow.traceName": "add"}, "request_preview": "{}", "response_preview": "5"}}}']]]
    ti = tr['trace'].trace_info
    assert['`ti.execution_duration`' eq '1.500s']
    assert['`ti.request_time`' eq '2026-11-06T22:34:56.762Z']
    held_at = ti.tags['mlflow.artifactLocation']
    assert[ends['`held_at`', '/traces/tr-abc/artifacts']]
    ts = json[api_trace_search[json['{"locations": [{"type": "MLFLOW_EXPERIMENT", "mlflow_experiment": {"experiment_id": "`exp`"}}]}']]]
    assert[len[ts.traces] eq 1]
    assert[duration_text[233] eq '0.233s' and duration_text[2000] eq '2s' and duration_text[1050] eq '1.050s']
    assert[error_status['missing'] eq 404 and error_code['exists'] eq 'RESOURCE_ALREADY_EXISTS']
