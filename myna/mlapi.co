--- ------------------------------------------------- registered models

fn _model_held[name]
    m = registry.model_named[name]
    if m.id eq ''
        return error['Registered Model with name=`name` not found', 'missing']
    return m

fn api_model_create[a]
    tracking.ready[]
    name = _need[_s[a, 'name'], 'name']
    if not name.ok
        return name
    m = registry.create_model[name, _s[a, 'description']]
    if not m.ok
        if m.kind eq 'exists'
            return error['Registered Model (name=`name`) already exists.', 'exists']
        return m
    tags = _pairs_in[a, 'tags']
    t = tracking.put_tags['registered_model', m.id, '', _keys_of[tags], _values_of[tags], true]
    if not t.ok
        return t
    return '{"registered_model": `model_json[m]`}'

