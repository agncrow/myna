--- Myna's scheduler: every fifteen seconds it runs the notebooks whose
--- schedules are due, as the notebook page runs them (myna/engine.co), and
--- writes each run to the runs log as the schedule's; and it refreshes the
--- dashboards that are due (myna/tiles.co). `crow run
--- scheduler.co` runs it until it is stopped; the Jobs page starts it
--- with the page's port (`crow run -i scheduler.co 3800`), and then it
--- also ends once the page has not answered for three rounds. Either way
--- it ends when asked to, by the file _scheduler.stop in the workspace's
--- folder (myna_data/, or MYNA_DATA), and says it is alive by writing
--- the moment of each round to _scheduler.beat there.
use myna.workspace
use myna.engine
use myna.tiles

fn _seconds[written_as]
    n = int[written_as]
    if not n.ok
        return 60
    m = n
    if m lt 1
        m = 60
    if m gt 3600
        m = 3600
    return m

fn _total[ms]
    total = 0
    for m in ms
        if m gt 0
            total = total + m
    if total lt 0
        total = 0
    if total gt 1000000000000000
        total = 1000000000000000
    return total

--- a notebook run whole, as the page runs it, and written to the runs log
fn _run_one[name, limit]
    srcs = workspace.sources[name]
    n = len[srcs]
    if n eq 0
        return 'empty'
    file = '`engine.slug[name]`.schedule'
    r = engine.run[workspace.home[], file, engine.program[srcs, n], limit]
    if not r.ok
        return 'did not run: `r.reason`'
    firsts = engine.starts_at[srcs, n]
    ended = engine.states[r.stdout, n, r.status, file, firsts]
    how = engine.verdict[ended]
    kept = workspace.put_run[name, str[now[]], 'schedule', n, how, _total[engine.times[r.stdout, n]], slice[r.stdout, 0, 100000]]
    if not kept.ok
        return '`how` (not recorded: `kept.reason`)'
    return '`how` (run `kept`)'

--- one round: the beat written, then every notebook that is due run
fn _round[limit]
    _beat = write['`workspace.home[]`/_scheduler.beat', str[now[]]]
    for name in workspace.scheduled[]
        due = workspace.due[name]
        if due ne ''
            t = moment[due]
            if t.ok
                if t lte now[]
                    log['`str[now[]]` `name`: `_run_one[name, limit]`']
    for dash in workspace.dashboards[]
        if tiles.due[dash]
            log['`str[now[]]` dashboard `dash`: `tiles.refresh[dash]` tiles refreshed']

--- whether the page that started the scheduler still answers (any answer
--- does, a 404 too)
fn _page_answers[port]
    r = request['http://127.0.0.1:`port`/myna-scheduler-asks']
    return r.ok

--- another scheduler's beat, newer than a round and a half
fn _another_runs[]
    if not exists['`workspace.home[]`/_scheduler.beat']
        return false
    text = read['`workspace.home[]`/_scheduler.beat']
    if not text.ok
        return false
    t = moment[trim[text]]
    if not t.ok
        return false
    return now[] - t lt 20.0

workspace.ready[]
given = args[]
port = ''
if len[given] gt 0
    port = given[0]
going = true
if _another_runs[]
    log['another scheduler is running (its beat is fresh): this one ends']
    going = false
else
    log['`str[now[]]` the scheduler starts']
--- the beat is this scheduler's own from its first round: it is removed
--- as it ends, and left alone by one that ends because another runs
owned = going
misses = 0
while going
    if exists['`workspace.home[]`/_scheduler.stop']
        gone = rm['`workspace.home[]`/_scheduler.stop']
        log['`str[now[]]` asked to stop']
        going = false
    else
        _round[_seconds[workspace.setting['limit', '60']]]
        if port ne ''
            if _page_answers[port]
                misses = 0
            else
                misses = misses + 1
            if misses gte 3
                log['`str[now[]]` the page on port `port` has not answered for three rounds']
                going = false
        if going
            sleep[15.0]
if owned
    if exists['`workspace.home[]`/_scheduler.beat']
        gone = rm['`workspace.home[]`/_scheduler.beat']
log['`str[now[]]` the scheduler ends']
